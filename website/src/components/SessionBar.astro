---
// SessionBar — the fixed terminal window bar. Replaces Header on every page.
// Left: wordmark + version. Center/right: mono nav. Far right: ThemeToggle.
// On the homepage the bar carries the scroll clock; elsewhere it shows the
// page path. No-JS: clock span renders its server-side default (no clock).
import ThemeToggle from './ThemeToggle.astro';
import { VERSION } from '../lib/version';

const path = Astro.url.pathname;
const onDocs = path.startsWith('/docs');
const isHome = path === '/' || path === '';

// Page path shown on non-home pages.
const pagePathMap: Record<string, string> = {
  '/guide': '~/think-os/guide',
  '/commands': '~/think-os/commands',
  '/changelog': '~/think-os/changelog',
};
let sessionLabel = '~/ThinkOS/vault';
if (!isHome) {
  const trimmed = path.replace(/\/$/, '');
  sessionLabel = pagePathMap[trimmed] || `~/think-os${trimmed}`;
}

const navItems = [
  { href: '/guide', label: 'guide', active: path.startsWith('/guide') },
  { href: '/commands', label: 'commands', active: path.startsWith('/commands') },
  { href: '/docs', label: 'docs', active: onDocs },
  { href: '/changelog', label: 'changelog', active: path.startsWith('/changelog') },
];
---
<header class="session-bar">
  <a href="/" class="flex items-baseline gap-2 shrink-0 group" aria-label="Think OS home">
    <span class="font-mono font-bold text-[13px] tracking-tight text-ink leading-none">think-os</span>
    <span class="hidden sm:inline font-mono text-[10px] tracking-[0.12em] text-muted">v{VERSION} · alpha</span>
  </a>

  <span class="font-mono text-[11px] text-muted hidden md:inline truncate" aria-hidden="true">
    {sessionLabel}{isHome && (<>{' · ● '}<span data-session-clock>08:38</span></>)}
  </span>

  <nav class="ml-auto flex items-center gap-3 md:gap-5">
    {navItems.map((n) => (
      <a
        href={n.href}
        class={`font-mono text-[12px] lowercase link-anim ${n.active ? 'text-ink' : 'text-muted'}`}
      >{n.label}</a>
    ))}
    <a
      href="https://github.com/dhirajsapkal/think-os"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline font-mono text-[12px] lowercase text-muted link-anim"
    >github ↗</a>
    <ThemeToggle />
  </nav>
</header>
