---
// FlowDiagram — S2 "How it works": three nodes joined by "→", left to right
// on desktop, stacked on mobile. Each node = mono label + a short caption.
// Pure CSS grid; content is passed as a `nodes` prop (label + html body).
interface Node {
  label: string;
  body: string; // may contain inline <code>
  files?: string[];
}
interface Props {
  nodes: Node[];
}
const { nodes } = Astro.props;
---
<div class="flow">
  {nodes.map((n, i) => (
    <>
      {i > 0 && (
        <div class="flow-link" aria-hidden="true" data-step={String(i * 2)} data-step-ms="420">
          <span class="flow-line"></span>
          <span class="flow-arrow">→</span>
        </div>
      )}
      <article class="flow-node pane" data-step={String(i * 2 + 1)} data-step-ms="500">
        <p class="flow-label">{n.label}</p>
        <p class="flow-body" set:html={n.body}></p>
        {n.files && (
          <div class="grid grid-cols-2 gap-1 mt-3">
            {n.files.map((name) => (
              <span class="font-mono text-[11px] px-2 py-1 border border-rule rounded-[3px] text-muted whitespace-nowrap">{name}</span>
            ))}
          </div>
        )}
      </article>
    </>
  ))}
</div>

<style>
  .flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .flow-node {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .flow-label {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .flow-label::before {
    content: '> ';
    color: var(--muted);
    font-weight: 500;
  }
  .flow-body {
    font-family: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .flow-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    position: relative;
  }
  /* The connector hairline; accent overlay draws L→R via .flow-line size. */
  .flow-link::before {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background: var(--rule);
  }
  .flow-line {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 50%;
    background-size: 100% 1px;
  }
  .flow-arrow {
    position: relative;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    color: var(--accent);
    background: var(--bg);
    padding: 0.2rem;
    transform: rotate(90deg);
    line-height: 1;
  }

  @media (min-width: 880px) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: stretch;
    }
    .flow-link {
      height: auto;
      width: 2.75rem;
    }
    .flow-link::before {
      width: 100%;
      height: 1px;
    }
    .flow-arrow { transform: none; }
  }

  :global(.flow-body code) {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.85em;
    background: var(--bg-bar);
    border: 1px solid var(--rule);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    color: var(--accent);
  }
</style>
