---
// FlowDiagram — S2 "How it works": three nodes joined by "→", left to right
// on desktop, stacked on mobile. Each node = mono label + a short caption.
// Pure CSS grid; content is passed as a `nodes` prop (label + html body).
interface Node {
  label: string;
  body: string; // may contain inline <code>
}
interface Props {
  nodes: Node[];
}
const { nodes } = Astro.props;
---
<div class="flow">
  {nodes.map((n, i) => (
    <>
      {i > 0 && <div class="flow-link" aria-hidden="true"><span class="flow-arrow">→</span></div>}
      <article class="flow-node">
        <p class="flow-label">{n.label}</p>
        <p class="flow-body" set:html={n.body}></p>
      </article>
    </>
  ))}
</div>

<style>
  .flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .flow-node {
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .flow-label {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .flow-label::before {
    content: '> ';
    color: var(--muted);
    font-weight: 500;
  }
  .flow-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .flow-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    position: relative;
  }
  .flow-link::before {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background: var(--rule);
  }
  .flow-arrow {
    position: relative;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    color: var(--accent);
    background: var(--paper);
    padding: 0.2rem;
    transform: rotate(90deg);
    line-height: 1;
  }

  @media (min-width: 880px) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: stretch;
    }
    .flow-link {
      height: auto;
      width: 2.75rem;
    }
    .flow-link::before {
      width: 100%;
      height: 1px;
    }
    .flow-arrow { transform: none; }
  }

  :global(.flow-body code) {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.85em;
    background: var(--soft);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: var(--ink);
  }
</style>
