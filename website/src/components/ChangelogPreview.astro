---
// ChangelogPreview — a quiet "See what's new" line under the install prompt.
// Pulls the newest entry from the changelog content collection so this line
// can never go stale; the /changelog page renders the full list.
import { getCollection } from 'astro:content';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latest = entries[0].data;
---
<a
  href="/changelog"
  class="group inline-flex items-baseline gap-3 link-anim"
>
  <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-muted">
    See what's new
  </span>
  <span class="font-mono text-[11px] tracking-[0.05em] text-ink/80">
    v{latest.version} — {latest.title}
  </span>
  <span class="font-mono text-[11px] text-muted group-hover:text-accent transition-colors">→</span>
</a>
