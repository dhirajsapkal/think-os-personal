---
import ThemeToggle from './ThemeToggle.astro';
import { VERSION } from '../lib/version';
const path = Astro.url.pathname;
const onDocs = path.startsWith('/docs');
---
<header class="border-b border-rule">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10">
    <div class="h-16 flex items-center justify-between">
      <a href="/" class="flex items-baseline gap-2 group">
        <span class="font-display text-[22px] tracking-tightest leading-none">Think OS</span>
        <span class="hidden sm:inline font-mono text-[10px] tracking-[0.18em] uppercase text-muted">v{VERSION} · alpha</span>
      </a>

      <nav class="flex items-center gap-4 md:gap-7">
        <a
          href="/guide"
          class={`font-mono text-[11px] tracking-[0.18em] uppercase link-anim ${path.startsWith('/guide') ? 'text-ink' : 'text-muted'}`}
        ><span class="md:hidden">Guide</span><span class="hidden md:inline">How to use it</span></a>
        <a
          href="/commands"
          class={`font-mono text-[11px] tracking-[0.18em] uppercase link-anim ${path.startsWith('/commands') ? 'text-ink' : 'text-muted'}`}
        >Commands</a>
        <a
          href="/docs"
          class={`font-mono text-[11px] tracking-[0.18em] uppercase link-anim ${onDocs ? 'text-ink' : 'text-muted'}`}
        >Docs</a>
        <a
          href="/changelog"
          class={`font-mono text-[11px] tracking-[0.18em] uppercase link-anim ${path.startsWith('/changelog') ? 'text-ink' : 'text-muted'}`}
        >Changelog</a>
        <a
          href="https://github.com/dhirajsapkal/think-os"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline font-mono text-[11px] tracking-[0.18em] uppercase text-muted link-anim"
        >GitHub ↗</a>
        <ThemeToggle />
      </nav>
    </div>
  </div>
</header>
