---
import ThinkCompanyMark from './ThinkCompanyMark.astro';
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-rule">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-14 md:py-16">

    <!-- Top row: pull-quote on left, Think Company block on right -->
    <div class="grid grid-cols-12 gap-8 items-end pb-10 border-b border-rule">
      <div class="col-span-12 md:col-span-7">
        <p class="font-display italic text-2xl md:text-[28px] leading-tight max-w-[22ch]">
          A markdown vault that<br />travels with you,<br />between agents.
        </p>
      </div>
      <div class="col-span-12 md:col-span-5 md:text-right">
        <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-muted mb-3">
          Built at
        </p>
        <div class="md:justify-end inline-flex md:flex">
          <ThinkCompanyMark size="md" />
        </div>
        <p class="mt-3 text-[13px] text-muted leading-relaxed max-w-[28ch] md:ml-auto">
          An experience design and development consultancy. In business since 2007.
        </p>
        <p class="mt-3">
          <a
            href="https://thinkcompany.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted link-anim"
          >thinkcompany.com ↗</a>
        </p>
      </div>
    </div>

    <!-- Bottom row: project meta -->
    <div class="grid grid-cols-12 gap-8 pt-10">
      <div class="col-span-12 md:col-span-7">
        <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-muted">
          Think OS · v0.7.0 · alpha
        </p>
        <p class="mt-2 text-sm text-muted">
          <a href="https://github.com/dhirajsapkal/think-os" class="link-anim hover:text-accent">
            github.com/dhirajsapkal/think-os
          </a>
        </p>
      </div>
      <div class="col-span-12 md:col-span-5 md:text-right">
        <p class="text-[12px] text-muted">
          Designed and built by Dhiraj Sapkal
        </p>
        <p class="text-[11px] text-muted/70 mt-1">
          © {year} Think Company
        </p>
      </div>
    </div>

  </div>
</footer>
