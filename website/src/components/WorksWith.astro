---
// WorksWith — small "plays well with" row.
// Mono row of integrations, separated by middots. No logos.
const integrations = [
  'Claude Code',
  'Basic Memory',
  'Granola',
  'Google Calendar',
  'Slack',
  'Gmail',
  'ClickUp',
  'Notion',
  'Confluence',
  'Figma',
  'GitHub',
];
---
<section class="border-t border-rule">
  <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-16 md:py-20">
    <div class="grid grid-cols-12 gap-6 items-baseline reveal">
      <div class="col-span-12 md:col-span-3">
        <p class="kicker">Plays well with</p>
      </div>
      <div class="col-span-12 md:col-span-9">
        <p class="font-mono text-[13px] md:text-[14px] leading-relaxed text-ink/80">
          {integrations.map((name, i) => (
            <span>
              {i > 0 && <span class="mx-2 text-muted">·</span>}
              <span>{name}</span>
            </span>
          ))}
        </p>
        <p class="mt-3 text-[14px] leading-relaxed text-muted max-w-[58ch]">
          Anything with an MCP server can read the vault. Most of the
          connectors above ship in the role-based bundles; the rest are one
          <code class="font-mono text-[12px] bg-soft px-1.5 py-0.5 rounded">/mcp</code> away.
        </p>
      </div>
    </div>
  </div>
</section>
