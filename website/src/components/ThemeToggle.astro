---
// Theme toggle — minimal text label, no icons.
---
<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  class="font-mono text-[12px] lowercase text-muted link-anim shrink-0"
>
  <span data-theme-label>dark ⇄</span>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const labelEl = btn.querySelector('[data-theme-label]');
    const html = document.documentElement;
    const setLabel = () => {
      const t = html.getAttribute('data-theme') || 'light';
      // Label names the theme you'd switch TO.
      labelEl.textContent = t === 'dark' ? 'light ⇄' : 'dark ⇄';
    };
    setLabel();
    btn.addEventListener('click', () => {
      const current = html.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('thinkos-theme', next);
      setLabel();
    });
  })();
</script>
