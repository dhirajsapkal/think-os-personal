---
// CommandStage — homepage Scene 4, interactive moment 1.
// Three keycap chips (tabs) swap which vignette plays. Markup is the three
// DayPairs beats (morning / decide / weekly-review) relocated here as panels.
//
// Each tab activation REPLAYS as a sequence: the command types char-by-char,
// the response prints line-by-line, then the file-effect (read highlight or
// diff lines) lights up last. Driven by a cancellable JS typing engine (CSS
// can't replay on repeated clicks), mirroring TryTerminal's approach.
//
// A11y: WAI-ARIA tabs. Visual panes are aria-hidden; one sr-only aria-live
// region receives the full transcript in a single mutation per panel.
// No-JS: chips hidden, all three panels render stacked + static.
// Reduced-motion + JS: chips work, swaps instant (full render, no typing).
//
// Copy verified against DayPairs.astro (v0.9.5 inventory).
import Pair from './Pair.astro';
import TerminalPane from './panes/TerminalPane.astro';
import FilePane from './panes/FilePane.astro';
import DiffPane from './panes/DiffPane.astro';

const tabs = [
  { id: 'morning', cmd: '/thinkos-morning', label: '08:40 · one command', time: '08:40', day: '' },
  { id: 'decide', cmd: '/thinkos-decide', label: '16:30 · a call worth keeping', time: '16:30', day: '' },
  { id: 'review', cmd: '/weekly-review', label: 'Sunday · 20:00', time: '20:00', day: 'sun' },
];
---
<div class="command-stage" data-command-stage>
  <!-- Single-shot live region for screen readers -->
  <div class="sr-only" aria-live="polite" data-stage-live></div>

  <!-- Chips / tablist — only meaningful with JS -->
  <div
    class="stage-tabs flex flex-wrap gap-2 mb-8"
    role="tablist"
    aria-label="A day with Think OS"
  >
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`stage-tab-${t.id}`}
        class="keycap"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`stage-panel-${t.id}`}
        tabindex={i === 0 ? '0' : '-1'}
        data-stage-chip={t.id}
        data-time={t.time}
        data-day={t.day}
      >{t.cmd}</button>
    ))}
  </div>

  <div class="stage-panels">
    <!-- PANEL: morning -->
    <div
      class="stage-panel"
      role="tabpanel"
      id="stage-panel-morning"
      aria-labelledby="stage-tab-morning"
      data-stage-panel="morning"
      data-time="08:40"
    >
      <p class="kicker stage-kicker mb-3">08:40 · one command</p>
      <Pair>
        <TerminalPane slot="left" label="claude code" tag="08:40"><span class="prompt">&gt;</span> <span class="cmd" data-stage-cmd>good morning</span><span class="cs-response" data-stage-response>

This week (top 3):
  1. v2 ingestion pipeline — cut release
  2. Q3 hiring plan, first draft Friday
  3. clear PR queue (T. + R.)

On your plate today:
  · v2 release notes
  · 1:1 with Priya, 2pm

Calendar: 2 meetings, both afternoon.</span></TerminalPane>
        <FilePane slot="right" path="01 Now / Current Focus.md" tag="read"><span class="dim">---</span>
<span class="dim">title:</span> Current Focus
<span class="dim">covers_week:</span> 2026-W24
<span class="dim">---</span>

<span class="read-row" data-stage-effect><span class="text-accent">## This week</span></span>

1. Ship v2 ingestion pipeline — cut
   the release this week.
2. Q3 hiring plan, first draft to
   Priya by Friday.
3. Clear two stuck PR reviews (T. and
   R.) — blocked on my sign-off.</FilePane>
      </Pair>
    </div>

    <!-- PANEL: decide -->
    <div
      class="stage-panel"
      role="tabpanel"
      id="stage-panel-decide"
      aria-labelledby="stage-tab-decide"
      data-stage-panel="decide"
      data-time="16:30"
      hidden
    >
      <p class="kicker stage-kicker mb-3">16:30 · a call worth keeping</p>
      <Pair>
        <TerminalPane slot="left" label="claude code" tag="16:30"><span class="prompt">&gt;</span> <span class="cmd" data-stage-cmd>/thinkos-decide we version the API from day one</span><span class="cs-response" data-stage-response>

Logged to 04 Knowledge/Decisions.md —
date, reasoning, and what it applies to.

/thinkos-decisions will surface it the
next time the question comes up.</span></TerminalPane>
        <DiffPane slot="right" path="04 Knowledge / Decisions.md" tag="+1 entry" stagger={false}><span data-stage-effect><span class="diff-add">+ ## 2026-06-11 — API versioning</span>
<span class="diff-add">+ **Decision**: Version the API from day one.</span>
<span class="diff-add">+ **Why**: Breaking changes after launch are</span>
<span class="diff-add">+ costlier than a /v1 prefix up front.</span>
<span class="diff-add">+ **Context**: design review, ingestion v2.</span>
<span class="diff-add">+ **Applies to**: all public endpoints.</span></span></DiffPane>
      </Pair>
    </div>

    <!-- PANEL: weekly-review -->
    <div
      class="stage-panel"
      role="tabpanel"
      id="stage-panel-review"
      aria-labelledby="stage-tab-review"
      data-stage-panel="review"
      data-time="20:00"
      data-day="sun"
      hidden
    >
      <p class="kicker stage-kicker mb-3">Sunday · 20:00</p>
      <Pair>
        <TerminalPane slot="left" label="claude code" tag="20:00"><span class="amber">CURRENT FOCUS STALE: covers_week ended</span>
<span class="amber">2026-06-07 — run /weekly-review</span>

<span class="prompt">&gt;</span> <span class="cmd" data-stage-cmd>/weekly-review</span><span class="cs-response" data-stage-response>

Read 7 days of Work Log. Last week's
focus archived. Proposed for next week:
  1. ship ingestion v2.1
  2. onboarding doc for the new hire
  3. close the Q3 hiring loop

Replace Current Focus with this? (y / n)</span></TerminalPane>
        <DiffPane slot="right" path="01 Now / Current Focus.md" tag="replaced" stagger={false}><span class="dim">## This week</span>

<span data-stage-effect><span class="diff-del">- ship v2 ingestion pipeline</span>
<span class="diff-del">- Q3 hiring plan, first draft</span>
<span class="diff-del">- clear PR queue (T. + R.)</span>
<span class="diff-add">+ ship ingestion v2.1</span>
<span class="diff-add">+ onboarding doc for the new hire</span>
<span class="diff-add">+ close the Q3 hiring loop</span></span></DiffPane>
      </Pair>
    </div>
  </div>

  <p class="mt-8 text-[15px] leading-relaxed text-muted max-w-[58ch]">
    Four moments. One command in the morning, one line when you decide
    something, and the rest happens on its own.
  </p>
  <p class="mt-4 font-mono text-[11px] tracking-[0.14em] uppercase">
    <a href="/guide" class="link-anim text-muted">The full rhythm, dos and don'ts included →</a>
  </p>
</div>

<style is:global>
  /* No-JS: hide the tablist, stack all panels visibly. */
  html:not(.js) .command-stage .stage-tabs { display: none; }
  html:not(.js) .command-stage .stage-panel[hidden] { display: block; }
  html:not(.js) .command-stage .stage-panel { margin-bottom: 3.5rem; }
  /* With JS: per-panel kicker is redundant with the chip; hide it. */
  html.js .command-stage .stage-kicker { display: none; }
  html.js .command-stage .stage-panel { margin-bottom: 0; }
  /* Hidden panels never show under JS. */
  html.js .command-stage .stage-panel[hidden] { display: none; }

  /* While a JS-driven replay is mid-flight, the response + file-effect are
     hidden until the engine reveals them. The .cs-playing flag is added by JS
     only when motion is permitted, so no-JS and reduced-motion never hide
     anything (full static render survives). */
  .command-stage.cs-playing [data-stage-response] { opacity: 0; }
  .command-stage.cs-playing [data-stage-effect] { opacity: 0; }
  .command-stage [data-stage-response].cs-on,
  .command-stage [data-stage-effect].cs-on {
    opacity: 1;
    transition: opacity 360ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-command-stage]');
    if (!root) return;
    var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      && document.documentElement.classList.contains('reveal-ready');
    var live = root.querySelector('[data-stage-live]');
    var chips = Array.prototype.slice.call(root.querySelectorAll('[data-stage-chip]'));
    var panels = {};
    Array.prototype.slice.call(root.querySelectorAll('[data-stage-panel]')).forEach(function (p) {
      panels[p.getAttribute('data-stage-panel')] = p;
    });
    var clockEl = document.querySelector('[data-session-clock]');
    var token = 0; // cancellation token for the active replay

    // Snapshot the final command + response text once, so replays can clear
    // and retype without losing the source content.
    function snapshot(panel) {
      if (panel._snap) return panel._snap;
      var cmd = panel.querySelector('[data-stage-cmd]');
      var resp = panel.querySelector('[data-stage-response]');
      panel._snap = {
        cmd: cmd ? cmd.textContent : '',
        cmdEl: cmd,
        respEl: resp,
        respText: resp ? resp.textContent : '',
        effectEl: panel.querySelector('[data-stage-effect]'),
      };
      return panel._snap;
    }

    function transcriptFor(panel) {
      var parts = [];
      panel.querySelectorAll('.pane-body').forEach(function (b) {
        parts.push(b.textContent.replace(/\s+\n/g, '\n').trim());
      });
      return parts.join('\n\n');
    }

    function instant(panel) {
      var s = snapshot(panel);
      if (s.cmdEl) s.cmdEl.textContent = s.cmd;
      if (s.respEl) { s.respEl.textContent = s.respText; s.respEl.classList.add('cs-on'); }
      if (s.effectEl) s.effectEl.classList.add('cs-on');
      if (live) live.textContent = transcriptFor(panel);
    }

    function replay(panel) {
      var my = ++token;
      root.classList.add('cs-playing');
      var s = snapshot(panel);
      // Reset to start state.
      if (s.cmdEl) s.cmdEl.textContent = '';
      if (s.respEl) s.respEl.classList.remove('cs-on');
      if (s.effectEl) s.effectEl.classList.remove('cs-on');

      var chars = s.cmd.split('');
      var ci = 0;
      function typeChar() {
        if (my !== token) return;
        if (ci < chars.length) {
          s.cmdEl.textContent += chars[ci++];
          setTimeout(typeChar, 32);
        } else {
          setTimeout(printResponse, 220);
        }
      }
      // Response is a single text node; reveal it line-by-line by growing the
      // visible slice. Keeps it cheap and avoids innerHTML.
      var respLines = s.respText.split('\n');
      var li = 0;
      function printResponse() {
        if (my !== token) return;
        if (!s.respEl) { lightEffect(); return; }
        s.respEl.classList.add('cs-on');
        if (li === 0) s.respEl.textContent = '';
        if (li < respLines.length) {
          s.respEl.textContent += (li === 0 ? '' : '\n') + respLines[li++];
          setTimeout(printResponse, 55);
        } else {
          setTimeout(lightEffect, 160);
        }
      }
      function lightEffect() {
        if (my !== token) return;
        if (s.effectEl) s.effectEl.classList.add('cs-on');
        if (live) live.textContent = transcriptFor(panel);
      }

      if (s.cmdEl) typeChar(); else printResponse();
    }

    function select(id, focusChip) {
      chips.forEach(function (c) {
        var on = c.getAttribute('data-stage-chip') === id;
        c.setAttribute('aria-selected', on ? 'true' : 'false');
        c.setAttribute('tabindex', on ? '0' : '-1');
        if (on && focusChip) c.focus();
      });
      for (var key in panels) {
        if (key === id) panels[key].removeAttribute('hidden');
        else panels[key].setAttribute('hidden', '');
      }
      var panel = panels[id];
      if (motion) replay(panel); else instant(panel);
      // SessionBar clock advances for decide / review.
      if (clockEl) {
        var chip = root.querySelector('[data-stage-chip="' + id + '"]');
        var t = chip.getAttribute('data-time');
        var d = chip.getAttribute('data-day');
        clockEl.textContent = (d ? d + ' ' : '') + t;
      }
    }

    chips.forEach(function (chip, i) {
      chip.addEventListener('click', function () {
        select(chip.getAttribute('data-stage-chip'), false);
      });
      chip.addEventListener('keydown', function (e) {
        var idx = i;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { idx = (i + 1) % chips.length; }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { idx = (i - 1 + chips.length) % chips.length; }
        else if (e.key === 'Home') { idx = 0; }
        else if (e.key === 'End') { idx = chips.length - 1; }
        else return;
        e.preventDefault();
        select(chips[idx].getAttribute('data-stage-chip'), true);
      });
    });

    // First panel: play once when the stage scrolls into view (motion), or
    // render static immediately (reduced-motion / instant).
    var first = panels['morning'];
    if (first) {
      if (motion && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              replay(first);
              io.disconnect();
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        io.observe(root);
      } else {
        instant(first);
      }
    }
  })();
</script>
