---
const command = 'Install Think OS for me from https://github.com/dhirajsapkal/think-os-personal';
---
<div class="install-card" data-install-prompt>
  <div class="flex items-baseline justify-between gap-4 px-4 md:px-5 h-9 bg-bar border-b border-rule">
    <span class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted truncate">
      setup prompt — paste into claude code
    </span>
    <button
      type="button"
      data-copy-trigger
      aria-label="Copy install prompt"
      class="copy-btn font-mono text-[10px] tracking-[0.14em] uppercase text-muted shrink-0"
    >
      <span data-copy-label>copy</span>
    </button>
  </div>
  <pre class="px-5 md:px-7 py-6 md:py-7 font-mono text-[15px] md:text-[17px] leading-relaxed text-ink whitespace-pre-wrap break-words m-0"><code data-copy-source>{command}</code></pre>
</div>

<script is:inline>
  // Scoped per instance, so multiple InstallPrompts on one page all work.
  (function () {
    document.querySelectorAll('[data-install-prompt]').forEach((card) => {
      const trigger = card.querySelector('[data-copy-trigger]');
      const source  = card.querySelector('[data-copy-source]');
      const label   = trigger?.querySelector('[data-copy-label]');
      if (!trigger || !source || !label) return;
      if (trigger.dataset.wired) return;
      trigger.dataset.wired = '1';

      trigger.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(source.textContent.trim());
          trigger.setAttribute('data-copied', 'true');
          label.textContent = 'copied';
          setTimeout(() => {
            trigger.removeAttribute('data-copied');
            label.textContent = 'copy';
          }, 1800);
        } catch (e) {
          label.textContent = 'failed';
          setTimeout(() => (label.textContent = 'copy'), 1800);
        }
      });
    });
  })();
</script>
