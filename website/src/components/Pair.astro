---
// Pair — the signature device. LEFT pane (what you typed) + RIGHT pane (the
// file that changed), joined by a hairline connector with a "→" glyph at the
// midpoint. Stacks vertically on mobile (terminal first, arrow rotates down).
//
// Slots: "left" and "right". Optional `tag` (a time/label) sits above the pair.
interface Props {
  tag?: string;
  /** When set, the connector becomes a choreography step that draws L→R. */
  connectorStep?: number;
}
const { tag, connectorStep } = Astro.props;
---
<div class="pair">
  {tag && <p class="kicker mb-3">{tag}</p>}
  <div class="pair-grid">
    <div class="pair-cell"><slot name="left" /></div>
    {connectorStep != null ? (
      <div class="pair-link pair-draw" aria-hidden="true" data-step={String(connectorStep)} data-step-ms="380"><span class="pair-arrow">→</span></div>
    ) : (
      <div class="pair-link" aria-hidden="true"><span class="pair-arrow">→</span></div>
    )}
    <div class="pair-cell"><slot name="right" /></div>
  </div>
</div>

<style>
  .pair-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: 0;
  }
  .pair-cell { min-width: 0; }

  /* Mobile connector — vertical hairline + downward arrow between stacked panes. */
  .pair-link {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    height: 2.75rem;
  }
  .pair-link::before {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background: var(--rule);
  }
  .pair-arrow {
    position: relative;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 13px;
    color: var(--accent);
    background: var(--bg);
    padding: 0.25rem;
    transform: rotate(90deg);
    line-height: 1;
  }

  @media (min-width: 900px) {
    .pair-grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .pair-link {
      height: auto;
      width: 3rem;
    }
    .pair-link::before {
      width: 100%;
      height: 1px;
    }
    .pair-arrow {
      transform: none;
    }
  }
</style>
