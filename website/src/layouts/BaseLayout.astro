---
// Fonts are self-hosted via fontsource — no CDN round-trip, no layout shift.
// Two faces total. Bricolage Grotesque (opsz axis) is the human voice —
// display headlines and prose. JetBrains Mono is the machine voice —
// everything terminal: panes, session bar, nav, code. The contrast is brand.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/jetbrains-mono/wght-italic.css';
import '../styles/global.css';
import SessionBar from '../components/SessionBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Think OS — personal context for every agent',
  description = 'A markdown vault and a context MCP server that gives Claude Code durable memory of who you are, what you\'re working on, and how you like to work.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.png" />
    <link rel="alternate" type="application/rss+xml" title="Think OS Changelog" href="/rss.xml" />
    <script is:inline>
      // Apply theme before paint to avoid flash. Default is dark — the site
      // IS the Live Session world; first visits land there regardless of OS
      // preference. The toggle persists the user's choice as before.
      (function () {
        const stored = localStorage.getItem('thinkos-theme');
        const theme = stored || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script is:inline>
      // js-flag — unconditional, no guards. ".js" means JavaScript is
      // available (controls which markup variant shows: chips vs stacked).
      // Distinct from ".reveal-ready" (motion permitted), added later.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[300] focus:bg-bar focus:border focus:border-accent focus:px-4 focus:py-2 focus:font-mono focus:text-[12px] focus:text-ink"
    >Skip to content</a>
    <div class="field" aria-hidden="true"></div>
    <SessionBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Two observers. The first adds .reveal-ready (motion permitted) and
      // animates scene light-ups + scroll typing — gated on IntersectionObserver
      // and prefers-reduced-motion. The second updates the session clock from
      // each scene's data-time — pure state, NOT motion, so it runs always.
      (function () {
        // Clock observer — runs regardless of motion preference. Text swap only.
        var clockEl = document.querySelector('[data-session-clock]');
        if (clockEl && 'IntersectionObserver' in window) {
          var scenes = document.querySelectorAll('.scene[data-time]');
          if (scenes.length) {
            var clockIO = new IntersectionObserver(function (entries) {
              for (var i = 0; i < entries.length; i++) {
                var e = entries[i];
                if (e.isIntersecting && e.intersectionRatio >= 0.5) {
                  var day = e.target.getAttribute('data-day');
                  var time = e.target.getAttribute('data-time');
                  clockEl.textContent = (day ? day + ' ' : '') + time;
                }
              }
            }, { threshold: [0.5] });
            for (var s = 0; s < scenes.length; s++) clockIO.observe(scenes[s]);
          }
        }

        // Reveal observer — motion-gated.
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('.scene, .reveal');
        if (!els.length) return;
        document.documentElement.classList.add('reveal-ready');
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                io.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      })();
    </script>
  </body>
</html>
