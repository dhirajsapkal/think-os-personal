---
// Fonts are self-hosted via fontsource — no CDN round-trip, no layout shift.
// Two faces total. Bricolage Grotesque (opsz axis) is the human voice —
// display headlines and prose. JetBrains Mono is the machine voice —
// everything terminal: panes, session bar, nav, code. The contrast is brand.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/jetbrains-mono/wght-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Think OS — personal context for every agent',
  description = 'A markdown vault and a context MCP server that gives Claude Code durable memory of who you are, what you\'re working on, and how you like to work.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.png" />
    <link rel="alternate" type="application/rss+xml" title="Think OS Changelog" href="/rss.xml" />
    <script is:inline>
      // Apply theme before paint to avoid flash. Light is the default — the
      // page is white paper with navy ink; dark navy panes sit on top. First
      // visits land in light regardless of OS preference. The toggle persists
      // the user's choice.
      (function () {
        const stored = localStorage.getItem('thinkos-theme');
        const theme = stored || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script is:inline>
      // js-flag — unconditional, no guards. ".js" means JavaScript is
      // available (controls which markup variant shows: chips vs stacked).
      // Distinct from ".reveal-ready" (motion permitted), added later.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[300] focus:bg-bar focus:border focus:border-accent focus:px-4 focus:py-2 focus:font-mono focus:text-[12px] focus:text-ink"
    >Skip to content</a>
    <div class="field" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Reveal + step-engine observers. Adds .reveal-ready (motion permitted)
      // and animates scene light-ups, scroll typing, and [data-choreo] step
      // sequences — gated on IntersectionObserver and prefers-reduced-motion.
      // The day-clock conceit is retired; no clock observer.
      (function () {
        // Reveal observer — motion-gated.
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('.scene, .reveal');
        if (!els.length) return;
        document.documentElement.classList.add('reveal-ready');
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                io.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        for (var j = 0; j < els.length; j++) io.observe(els[j]);

        // ----------------------------------------------------------------
        // Step engine — sequenced choreography for [data-choreo] scenes.
        // On first intersect, walk [data-step] groups in ascending order:
        // add .step-on to all elements of step N, wait that step's duration,
        // then advance. Steps may repeat a number (simultaneous). Only runs
        // under reveal-ready (motion permitted); without it the CSS shows all
        // steps static. Once-only via its own observer + a played flag.
        // ----------------------------------------------------------------
        var choreoScenes = document.querySelectorAll('[data-choreo]');
        if (choreoScenes.length) {
          var stepDuration = function (el) {
            // type-line elements: CSS typing is a fixed 900ms + 200ms buffer.
            var hasType = el.classList.contains('type-line')
              || el.querySelector('.type-line');
            if (hasType) return 1100;
            var attr = parseInt(el.getAttribute('data-step-ms'), 10);
            return isNaN(attr) ? 700 : attr;
          };
          var playChoreo = function (scene) {
            if (scene.getAttribute('data-choreo-played') === '1') return;
            scene.setAttribute('data-choreo-played', '1');
            var stepped = Array.prototype.slice.call(
              scene.querySelectorAll('[data-step]')
            );
            // Group by step number, ascending.
            var order = [];
            var groups = {};
            stepped.forEach(function (el) {
              var n = parseInt(el.getAttribute('data-step'), 10) || 0;
              if (!groups[n]) { groups[n] = []; order.push(n); }
              groups[n].push(el);
            });
            order.sort(function (a, b) { return a - b; });
            var gi = 0;
            var runGroup = function () {
              if (gi >= order.length) return;
              var els = groups[order[gi++]];
              var wait = 0;
              els.forEach(function (el) {
                el.classList.add('step-on');
                var d = stepDuration(el);
                if (d > wait) wait = d;
              });
              setTimeout(runGroup, wait);
            };
            runGroup();
          };
          var choreoIO = new IntersectionObserver(
            function (entries) {
              for (var k = 0; k < entries.length; k++) {
                if (entries[k].isIntersecting) {
                  playChoreo(entries[k].target);
                  choreoIO.unobserve(entries[k].target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          for (var c = 0; c < choreoScenes.length; c++) {
            choreoIO.observe(choreoScenes[c]);
          }
        }
      })();
    </script>
  </body>
</html>
