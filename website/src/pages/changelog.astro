---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Render every entry inline — one scroll, newest-first.
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  })
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title="Changelog · Think OS"
  description="What's shipped, in reverse chronological order. Subscribe via RSS."
>

  <!-- HEADER -->
  <section class="border-b border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-20 md:pt-28 pb-14 md:pb-20">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-2">
          <p class="kicker">Public log</p>
          <h1 class="display lift lift-1 mt-6 text-[44px] md:text-[80px] tracking-tightest">
            Changelog.
          </h1>
          <p class="lift lift-2 mt-8 max-w-[60ch] text-[17px] md:text-[19px] leading-relaxed text-muted">
            What shipped, in reverse chronological order. Newest at the top.
            Maintainer-facing detail lives in
            <a
              href="https://github.com/dhirajsapkal/think-os/blob/main/CHANGELOG.md"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-accent"
            >CHANGELOG.md</a>;
            this page is the friendlier version.
          </p>
          <p class="lift lift-3 mt-6 font-mono text-[11px] tracking-[0.18em] uppercase text-muted">
            <a href="/rss.xml" class="link-anim">Subscribe via RSS ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTRIES -->
  <section>
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-16 md:py-20">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-2">

          {rendered.map(({ entry, Content }, i) => (
            <article class={`changelog-entry ${i > 0 ? 'border-t border-rule pt-16 mt-16 md:pt-20 md:mt-20' : ''}`}>

              <header class="mb-8">
                <p class="kicker">
                  v{entry.data.version}
                  <span class="mx-2 opacity-50">·</span>
                  {dateFormatter.format(entry.data.date)}
                </p>
                <h2 class="display text-3xl md:text-[42px] mt-4 tracking-tight">
                  {entry.data.title}
                </h2>
                <p class="mt-5 max-w-[58ch] text-[17px] leading-relaxed text-muted font-display italic">
                  {entry.data.summary}
                </p>
              </header>

              <div class="prose changelog-prose">
                <Content />
              </div>

            </article>
          ))}

        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <div class="ornament py-16">❦ &nbsp; · &nbsp; ❦ &nbsp; · &nbsp; ❦</div>

</BaseLayout>

<style is:global>
  /* Tighten prose for changelog entries — they're short and structural. */
  .changelog-prose h3 {
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }
  .changelog-prose h3:first-child {
    margin-top: 0.5rem;
  }
  .changelog-prose ul {
    padding-left: 1rem;
    list-style-type: none;
  }
  .changelog-prose ul li {
    position: relative;
    padding-left: 1.25rem;
  }
  .changelog-prose ul li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .changelog-prose p strong:first-child {
    font-weight: 500;
    color: var(--ink);
  }
</style>
