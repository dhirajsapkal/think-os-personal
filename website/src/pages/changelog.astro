---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Render every entry inline — one scroll, newest-first.
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  })
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const anchor = (version: string) => `v${version.replace(/\./g, '-')}`;
---
<BaseLayout
  title="Changelog · Think OS"
  description="What's shipped, in reverse chronological order. Subscribe via RSS."
>

  <!-- HEADER — boot-style opener -->
  <section class="border-b border-rule play-on-load">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-14 md:pt-20 pb-14 md:pb-20">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-10 md:col-start-2">
          <pre class="font-mono text-[13px] md:text-[14px] leading-[1.8] text-ink m-0"><span class="prompt">$</span> <span class="cmd type-line" style="--type-ch:18ch; --type-steps:18; --type-start:220ms">git log --oneline</span></pre>
          <h1 class="display po-1 mt-6 text-[clamp(40px,8vw,80px)] tracking-tightest">
            Changelog.
          </h1>
          <p class="po-2 mt-7 max-w-[60ch] text-[17px] md:text-[19px] leading-relaxed text-muted" style="font-variation-settings:'opsz' 16">
            What shipped, in reverse chronological order. Newest at the top.
            Maintainer-facing detail lives in
            <a
              href="https://github.com/dhirajsapkal/think-os/blob/main/CHANGELOG.md"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-accent"
            >CHANGELOG.md</a>;
            this page is the friendlier version.
          </p>
          <p class="po-3 mt-6 font-mono text-[11px] tracking-[0.12em] uppercase text-muted">
            <a href="/rss.xml" class="link-anim">Subscribe via RSS ↗</a>
          </p>

          <!-- VERSION INDEX — every release as a keycap chip; latest carries the dot. -->
          <nav class="po-4 mt-10 flex flex-wrap gap-2" aria-label="Jump to a release">
            {entries.map((entry, i) => (
              <a
                href={`#${anchor(entry.data.version)}`}
                class={`chip ${i === 0 ? 'chip--latest' : ''}`}
              >v{entry.data.version}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTRIES — timeline rhythm: sticky version rail, hairline spine. -->
  <section>
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-16 md:py-20">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-10 md:col-start-2">

          {rendered.map(({ entry, Content }, i) => (
            <article
              id={anchor(entry.data.version)}
              class={`changelog-entry scroll-mt-24 grid grid-cols-12 gap-x-6 reveal ${i > 0 ? 'mt-4' : ''}`}
            >

              <!-- Version rail -->
              <div class="col-span-12 md:col-span-3 pt-2 md:pb-16">
                <div class="md:sticky md:top-24">
                  <a
                    href={`#${anchor(entry.data.version)}`}
                    class={`chip ${i === 0 ? 'chip--latest' : ''}`}
                    aria-label={`Link to v${entry.data.version}`}
                  >v{entry.data.version}</a>
                  <p class="kicker mt-4">{dateFormatter.format(entry.data.date)}</p>
                  {i === 0 && (
                    <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-accent mt-2">Latest release</p>
                  )}
                </div>
              </div>

              <!-- Entry body — a lit artifact, hung off the timeline spine -->
              <div class="timeline-body col-span-12 md:col-span-9 relative md:border-l md:border-rule md:pl-10 pt-2 pb-16 md:pb-20">
                <div class="pane">
                  <div class="pane-bar">
                    <span class="pane-path" style="color:var(--pane-accent)">v{entry.data.version}</span>
                    <span class="pane-tag">{dateFormatter.format(entry.data.date)}</span>
                  </div>
                  <div class="p-6 md:p-8">
                    <header class="mb-6">
                      <h2 class="display font-bold text-[26px] md:text-[36px] tracking-tightest leading-tight" style="font-variation-settings:'opsz' 36">
                        {entry.data.title}
                      </h2>
                      <p class="mt-4 max-w-[58ch] text-[16px] leading-relaxed text-muted" style="font-variation-settings:'opsz' 16">
                        {entry.data.summary}
                      </p>
                    </header>

                    <div class="prose changelog-prose">
                      <Content />
                    </div>
                  </div>
                </div>
              </div>

            </article>
          ))}

        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  /* Timeline node — a small brand-blue point where each entry meets the spine. */
  @media (min-width: 768px) {
    .timeline-body::before {
      content: '';
      position: absolute;
      left: -4.5px;
      top: 1.05rem;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--bg);
      border: 1.5px solid var(--accent);
    }
    .changelog-entry:first-of-type .timeline-body::before {
      background: var(--accent);
    }
  }

  /* Tighten prose for changelog entries — they're short and structural. */
  .changelog-prose h3 {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }
  .changelog-prose h3:first-child {
    margin-top: 0.5rem;
  }
  /* Changelog h3s are uppercase mono labels — drop the "### " glyph. */
  .changelog-prose h3::before { content: none; }
  .changelog-prose ul {
    padding-left: 1rem;
    list-style-type: none;
  }
  .changelog-prose ul li {
    position: relative;
    padding-left: 1.25rem;
  }
  .changelog-prose ul li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .changelog-prose p strong:first-child {
    font-weight: 500;
    color: var(--ink);
  }
  /* Target flash on anchor land. */
  .changelog-entry:target {
    animation: target-flash 1200ms ease-out;
  }
  @keyframes target-flash {
    0%   { background-color: color-mix(in srgb, var(--accent) 8%, transparent); }
    100% { background-color: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .changelog-entry:target {
      animation: none;
    }
  }
</style>
