<script is:inline>
  // ----------------------------------------------------------------
  // S1 hero parallax — translate collage layers at different rates on
  // scroll. Transform only (compositor-friendly). Disabled under
  // reduced-motion and without IntersectionObserver/rAF support.
  // ----------------------------------------------------------------
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var layers = Array.prototype.slice.call(
      document.querySelectorAll('.hero-collage [data-parallax]')
    );
    if (!layers.length) return;
    // capture each layer's authored rotation so parallax composes with it.
    var base = layers.map(function (el) {
      var t = getComputedStyle(el).transform;
      return t && t !== 'none' ? t : '';
    });
    var ticking = false;
    function update() {
      ticking = false;
      var y = window.scrollY || window.pageYOffset || 0;
      for (var i = 0; i < layers.length; i++) {
        var rate = parseFloat(layers[i].getAttribute('data-parallax')) || 0;
        var dy = Math.round(-y * rate);
        layers[i].style.transform = 'translateY(' + dy + 'px) ' + base[i];
      }
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
    }, { passive: true });
    update();
  })();

  // ----------------------------------------------------------------
  // S2 read-trace — the COMPLETE conversation (prompt + three traced
  // lines + caption) is server-rendered and visible by default, so
  // reduced-motion / no-JS see the finished result with zero work.
  //
  // When motion is permitted (reveal-ready) and the scene first enters,
  // we clear and REPLAY the sequence using the cancellable-typing
  // pattern: type the prompt, then per traced line glow its source chip
  // and print the line, then reveal the caption last.
  //
  // Independently, hovering/focusing a printed line re-glows its source
  // chip and draws an SVG connector (works regardless of replay).
  // ----------------------------------------------------------------
  (function () {
    var root = document.querySelector('[data-read-root]');
    if (!root) return;
    var svg = root.querySelector('[data-trace-svg]');
    var lines = Array.prototype.slice.call(root.querySelectorAll('.trace-line'));
    var chips = Array.prototype.slice.call(root.querySelectorAll('.rail-chip'));
    var cmdEl = root.querySelector('[data-read-cmd]');
    var caption = root.querySelector('[data-read-caption]');
    var svgNS = 'http://www.w3.org/2000/svg';
    var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      && document.documentElement.classList.contains('reveal-ready');

    function chipFor(name) {
      for (var i = 0; i < chips.length; i++) {
        if (chips[i].getAttribute('data-chip') === name) return chips[i];
      }
      return null;
    }
    function lineFor(name) {
      // returns the SVG <line> created for this source, or makes one.
      if (!svg) return null;
      var existing = svg.querySelector('line[data-for="' + name + '"]');
      if (existing) return existing;
      var ln = document.createElementNS(svgNS, 'line');
      ln.setAttribute('data-for', name);
      svg.appendChild(ln);
      return ln;
    }
    function position(name, btn) {
      var chip = chipFor(name);
      var ln = lineFor(name);
      if (!chip || !ln || !svg) return;
      var sb = svg.getBoundingClientRect();
      var cb = chip.getBoundingClientRect();
      var bb = btn.getBoundingClientRect();
      // from chip's left edge midpoint → response line's right edge midpoint.
      ln.setAttribute('x1', cb.left - sb.left);
      ln.setAttribute('y1', cb.top + cb.height / 2 - sb.top);
      ln.setAttribute('x2', bb.right - sb.left);
      ln.setAttribute('y2', bb.top + bb.height / 2 - sb.top);
    }
    function glow(name, btn, on) {
      var chip = chipFor(name);
      if (chip) chip.classList.toggle('chip-lit', on);
      var ln = svg ? svg.querySelector('line[data-for="' + name + '"]') : null;
      if (on) { position(name, btn); if (ln) ln.classList.add('on'); }
      else if (ln) ln.classList.remove('on');
    }

    lines.forEach(function (btn) {
      var name = btn.getAttribute('data-source');
      btn.addEventListener('mouseenter', function () { glow(name, btn, true); });
      btn.addEventListener('mouseleave', function () { glow(name, btn, false); });
      btn.addEventListener('focus', function () { glow(name, btn, true); });
      btn.addEventListener('blur', function () { glow(name, btn, false); });
    });

    // keep any active connector aligned on resize.
    window.addEventListener('resize', function () {
      lines.forEach(function (btn) {
        var name = btn.getAttribute('data-source');
        var chip = chipFor(name);
        if (chip && chip.classList.contains('chip-lit')) position(name, btn);
      });
    }, { passive: true });

    // ---- Replay (cancellable) ----------------------------------------
    // Capture the server-rendered final text so we can restore it after a
    // replay and so reduced-motion never has to touch the DOM.
    var promptText = cmdEl ? cmdEl.textContent : '';
    var lineText = lines.map(function (btn) {
      var span = btn.querySelector('.line-stagger');
      return span ? span.textContent : btn.textContent;
    });
    var token = 0;

    function setLineVisible(i, on) {
      var span = lines[i] && lines[i].querySelector('.line-stagger');
      if (span) span.style.visibility = on ? '' : 'hidden';
    }
    function clearGlows() {
      chips.forEach(function (c) { c.classList.remove('chip-lit'); });
      if (svg) {
        var on = svg.querySelectorAll('line.on');
        for (var i = 0; i < on.length; i++) on[i].classList.remove('on');
      }
    }

    function replay() {
      var my = ++token;
      clearGlows();
      // clear conversation to the empty state.
      if (cmdEl) cmdEl.textContent = '';
      for (var i = 0; i < lines.length; i++) setLineVisible(i, false);
      if (caption) caption.style.visibility = 'hidden';

      var chars = promptText.split('');
      var ci = 0;
      function typeChar() {
        if (my !== token) return;
        if (ci < chars.length) {
          if (cmdEl) cmdEl.textContent += chars[ci++];
          setTimeout(typeChar, 32);
        } else {
          setTimeout(function () { traceLine(0); }, 320);
        }
      }
      function traceLine(i) {
        if (my !== token) return;
        if (i >= lines.length) {
          if (caption) caption.style.visibility = '';
          return;
        }
        var btn = lines[i];
        var name = btn.getAttribute('data-source');
        glow(name, btn, true);            // light source chip + connector
        setTimeout(function () {
          if (my !== token) return;
          setLineVisible(i, true);        // print the traced line
          setTimeout(function () {
            if (my !== token) return;
            glow(name, btn, false);       // release before the next line
            traceLine(i + 1);
          }, 620);
        }, 360);
      }
      typeChar();
    }

    if (motion) {
      // Hide the final state up front so the replay reads as a build, not a
      // flash. (reveal-ready guarantees JS ran; reduced-motion keeps static.)
      if (cmdEl) cmdEl.textContent = '';
      for (var li = 0; li < lines.length; li++) setLineVisible(li, false);
      if (caption) caption.style.visibility = 'hidden';

      if ('IntersectionObserver' in window) {
        var played = false;
        var io = new IntersectionObserver(function (entries) {
          for (var e = 0; e < entries.length; e++) {
            if (entries[e].isIntersecting && !played) {
              played = true;
              replay();
              io.disconnect();
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        io.observe(root);
      } else {
        replay();
      }
    }
  })();

  // ----------------------------------------------------------------
  // S4 day chapters — ARIA tablist over four server-rendered panels.
  // Each panel holds the COMPLETE chapter (typed command, printed
  // response, effect pane) as static markup; [hidden] keeps the
  // inactive ones out. No-JS / reduced-motion therefore see a working
  // tab pattern with full content — no innerHTML injection anywhere.
  //
  // When motion is permitted, the active chapter REPLAYS using the
  // cancellable-typing pattern: read the text from the DOM, clear it,
  // type the command, print the response, then reveal the effect pane.
  // Chapter 0 auto-replays on scene enter; switching tabs replays that
  // chapter. ARIA tablist + arrow-key roving focus preserved.
  // ----------------------------------------------------------------
  (function () {
    var root = document.querySelector('[data-day-root]');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('.day-tab'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-chapter-panel]'));
    if (!tabs.length || !panels.length) return;

    var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      && document.documentElement.classList.contains('reveal-ready');
    var token = 0;
    var current = 0;

    // Snapshot each panel's server-rendered final state so a replay can
    // clear then restore it. Effect-pane body/note keep their original HTML.
    var snaps = panels.map(function (panel) {
      var cmdEl = panel.querySelector('[data-day-cmd]');
      var outEl = panel.querySelector('[data-day-out]');
      var fxBody = panel.querySelector('[data-day-fx-body]');
      var fxNote = panel.querySelector('[data-day-fx-note]');
      return {
        panel: panel,
        cmdEl: cmdEl,
        outEl: outEl,
        fxBody: fxBody,
        fxNote: fxNote,
        cmd: cmdEl ? cmdEl.textContent : '',
        out: outEl ? outEl.textContent : '',
        fxHTML: fxBody ? fxBody.innerHTML : '',
        noteHidden: fxNote ? fxNote.hidden : true,
      };
    });

    function restore(s) {
      if (s.cmdEl) s.cmdEl.textContent = s.cmd;
      if (s.outEl) s.outEl.textContent = s.out;
      if (s.fxBody) s.fxBody.innerHTML = s.fxHTML;
      if (s.fxNote) s.fxNote.hidden = s.noteHidden;
    }

    function replay(idx) {
      var my = ++token;
      var s = snaps[idx];
      if (!s) return;
      // clear to empty.
      if (s.cmdEl) s.cmdEl.textContent = '';
      if (s.outEl) s.outEl.textContent = '';
      if (s.fxBody) s.fxBody.innerHTML = '';
      if (s.fxNote) s.fxNote.hidden = true;

      var chars = s.cmd.split('');
      var ci = 0;
      function typeChar() {
        if (my !== token) return;
        if (ci < chars.length) {
          if (s.cmdEl) s.cmdEl.textContent += chars[ci++];
          setTimeout(typeChar, 35);
        } else {
          setTimeout(printOut, 260);
        }
      }
      function printOut() {
        if (my !== token) return;
        if (s.outEl) s.outEl.textContent = s.out;
        setTimeout(function () {
          if (my !== token) return;
          if (s.fxBody) s.fxBody.innerHTML = s.fxHTML;
          if (s.fxNote) s.fxNote.hidden = s.noteHidden;
        }, 220);
      }
      typeChar();
    }

    function showPanel(idx) {
      panels.forEach(function (p, i) { p.hidden = i !== idx; });
    }

    function selectTab(idx, animate) {
      tabs.forEach(function (t, i) {
        var on = i === idx;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
      });
      showPanel(idx);
      current = idx;
      // Always restore the target panel's final state first, so a non-animated
      // path (or a cancelled replay) lands on the complete chapter.
      restore(snaps[idx]);
      if (animate) replay(idx);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { selectTab(i, motion); });
      tab.addEventListener('keydown', function (e) {
        var dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        var next = (i + dir + tabs.length) % tabs.length;
        tabs[next].focus();
        selectTab(next, motion);
      });
    });

    // Auto-replay chapter 0 on scene enter (motion only). Without motion the
    // panels already show the complete static result — nothing to do.
    if (motion && 'IntersectionObserver' in window) {
      var played = false;
      var io = new IntersectionObserver(function (entries) {
        for (var e = 0; e < entries.length; e++) {
          if (entries[e].isIntersecting && !played) {
            played = true;
            replay(current);
            io.disconnect();
          }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      io.observe(root);
    }
  })();
</script>
