---
// Homepage — five sections + FAQ, kept deliberately short.
// What moved where:
//   "Built in" cards        → /docs/whats-installed
//   "Files, not a database" → /docs/architecture
//   Vaults + VaultTree      → /docs/multi-vault
//   36-command table        → /commands
//   Continuous capture      → /docs/continuous-capture
//   Staying current         → /docs/update-protocol
// The user-facing playbook (daily/weekly rhythm, dos & don'ts) is /guide.
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import ConversationStrip from '../components/ConversationStrip.astro';
import TrustBar from '../components/TrustBar.astro';
import WorksWith from '../components/WorksWith.astro';
import ChangelogPreview from '../components/ChangelogPreview.astro';

const orientation = [
  {
    kicker: 'What',
    body: 'A folder of markdown files Claude reads at the start of every session — so it knows your role, your week, your people, your decisions, without you re-typing them.',
  },
  {
    kicker: 'Who',
    body: 'Anyone who uses Claude Code for real work and is tired of being a stranger every session. No agent-architecture knowledge required — install it, then follow the guide.',
  },
  {
    kicker: 'Trust',
    body: 'Local-first; nothing leaves your machine unless you sync it. Conversational writes are confirmed with you; automatic captures are metadata-only, ledger-logged, and undoable.',
  },
];

const rules = [
  {
    n: 'I',
    title: 'Files are the source of truth.',
    body: 'Tool memory, the Basic Memory index, and any tool-specific cache are derivatives. The markdown on disk is canonical.',
  },
  {
    n: 'II',
    title: 'Always-loaded context stays small.',
    body: 'Identity and this week\'s focus load verbatim — they\'re small, and verbatim reads are the grounding. Everything bigger is searched first, then read in scoped spans. Nothing rides along in every session unless it earns the tokens.',
  },
  {
    n: 'III',
    title: 'Personal stays personal. Team stays team.',
    body: 'Your private notes live in a vault only you can see. Project work lives in a separate vault shared with your team. The structure makes accidental crossover impossible.',
  },
];

const faqs = [
  {
    q: 'What do I actually do day to day?',
    a: 'One command in the morning (/thinkos-morning), a one-line capture when you make a decision worth keeping, and a twenty-minute /weekly-review on Sunday — the rest happens on its own. The full rhythm, dos and don\'ts included, is in',
    link: { href: '/guide', label: 'How to use it' },
  },
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Why markdown files instead of a vector or graph database?',
    a: 'You don\'t have to choose. Basic Memory derives a hybrid index from your files — SQLite full-text search, local vector embeddings, and a knowledge graph built from your notes\' own links — so you get database-grade retrieval without giving up the files. DB-native memory systems run an LLM over every write to extract "facts," which costs tokens and bakes mistakes into the store; verbatim markdown stays auditable, git-diffable, and editable anywhere. The long version, tradeoffs included, is in docs/why-files-not-a-database.md on GitHub.',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory itself is free and runs locally — no cloud mode, no recurring infrastructure cost. Phase 3 maintenance jobs run as local launchd jobs. The daily reindex uses no API tokens. The weekly review, quarterly archive, and morning brief each spawn a local claude session when they fire — those consume Anthropic API tokens; whether that\'s included in your Claude subscription or charged as pay-as-you-go depends on your account.',
  },
  {
    q: 'Which agent surfaces does Think OS support?',
    a: 'Claude Code is the first surface — full feature set: slash commands, autonomous launchd capture, drift-aware updates, vault health, cross-machine sync. Cowork and Codex live on the roadmap/cowork-codex branch and will be cherry-picked back in when their plugin formats stabilize. The vault itself is plain markdown plus a Basic Memory MCP — it works with any MCP-capable agent today (Claude Desktop, mobile, anywhere the MCP runs), you just lose the slash commands.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- HERO -->
  <section class="wash-hero">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-20 md:pt-28 pb-24 md:pb-36">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-2">
          <div class="lift lift-1">
            <a
              href="https://thinkcompany.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[10px] tracking-[0.18em] uppercase text-muted hover:text-accent transition-colors"
            >
              A project from Think Company
            </a>
          </div>

          <h1 class="display lift lift-2 mt-8 text-[44px] md:text-[88px] lg:text-[104px] tracking-tightest">
            Personal context<br />
            that follows you<br />
            into <em>every agent session.</em>
          </h1>

          <p class="lift lift-3 mt-10 md:mt-12 max-w-[58ch] text-[17px] md:text-[19px] leading-relaxed text-muted">
            Your agent knows who you are before you say a word — your role, what
            you're on this week, how you like to be written to. A markdown vault
            on your disk, surfaced through a context MCP server, loaded into
            every Claude Code session.
          </p>

          <div class="lift lift-4 mt-12 max-w-[820px]">
            <InstallPrompt />
          </div>

          <div class="lift lift-5 mt-6 max-w-[820px]">
            <ChangelogPreview />
          </div>

          <div class="lift lift-6 mt-10 max-w-[820px]">
            <TrustBar />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- § I — WHAT IT IS, WHO IT'S FOR -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-14 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">I</p>
          <p class="kicker mt-5">§ I</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">What it is, who it's for</h2>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule reveal">
        {orientation.map((o) => (
          <article class="bg-paper p-7 md:p-9 hover-card">
            <p class="kicker">{o.kicker}</p>
            <p class="mt-5 text-[16px] leading-relaxed text-muted max-w-[44ch]">{o.body}</p>
          </article>
        ))}
      </div>

      <p class="mt-8 text-[15px] leading-relaxed text-muted max-w-[66ch] reveal">
        Everything the install actually drops in — the instruction stack, the
        thirty-six commands, the role-based bundles — is itemized on
        <a href="/docs/whats-installed" class="underline underline-offset-2 hover:text-accent">What's installed</a>.
      </p>
    </div>
  </section>

  <!-- § II — GET STARTED IN THREE STEPS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">II</p>
          <p class="kicker mt-5">§ II</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Get started in three steps</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            About fifteen to thirty minutes once. Zero overhead after — the
            vault fills in from your real conversations, not a long Q&A. Bulk
            seeding from your connected tools is opt-in, not required.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-12">
        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:pr-8 reveal">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 1</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~5 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Install</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Paste the install prompt into a fresh Claude Code session. The agent
            clones the repo, asks five questions (vault location, Basic Memory,
            plugin bundle, vault name, and which folders hold your real work —
            automatic capture watches only those), optionally offers capability
            add-ons (Playwright browser capture, GitHub CLI auth), and runs the
            install.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:px-8 reveal" style="--reveal-delay: 90ms">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 2</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~2 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Restart + authenticate</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Quit Claude Code and reopen it. MCPs and new slash commands only
            load on startup.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            If you installed a plugin bundle, type
            <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/mcp</code> and
            authorize each connector listed.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:pl-8 reveal" style="--reveal-delay: 180ms">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 3 — opt-in</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~15–30 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Continue, when you want</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Skip this and the vault still fills in — emergent seeding watches
            your real conversations and proposes entries you confirm. Or run
            <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/thinkos-continue</code>
            to bulk-seed: import an existing markdown vault, pull from your
            connected tools, and draft Identity, Project Index, Current Focus,
            and People in one sitting.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Then read
            <a href="/guide" class="underline underline-offset-2 text-ink hover:text-accent"><strong>How to use it</strong></a> →
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- WORKS WITH -->
  <WorksWith />

  <!-- § III — A DAY WITH IT -->
  <ConversationStrip />

  <!-- § IV — THREE RULES -->
  <section class="border-t border-rule bg-soft/40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">IV</p>
          <p class="kicker mt-5">§ IV</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Three rules</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            The architecture in one screen. If anything goes wrong, it'll be because
            one of these got violated.
          </p>
        </div>
      </header>

      <div class="space-y-10">
        {rules.map((r, i) => (
          <div
            class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8 reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="col-span-2 md:col-span-1">
              <span class="numeral text-3xl md:text-4xl">{r.n}</span>
            </div>
            <div class="col-span-10 md:col-span-6">
              <p class="font-display text-2xl md:text-3xl tracking-tight">{r.title}</p>
            </div>
            <div class="col-span-12 md:col-span-5">
              <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">{r.body}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-12 gap-6 mt-16 reveal">
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="pullquote text-2xl md:text-[32px] max-w-[26ch]">
            Markdown is the source of truth. Everything else is a rebuildable index.
          </p>
          <p class="mt-5 text-[15px] leading-relaxed text-muted max-w-[60ch]">
            The why — and what dedicated databases genuinely do better — is in
            <a href="/docs/architecture" class="underline underline-offset-2 hover:text-accent">the architecture page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- § V — QUESTIONS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-12 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">V</p>
          <p class="kicker mt-5">§ V</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Questions</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            What testers usually ask first.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-6 reveal">
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="faq-body">
                {f.a}
                {f.link && (
                  <>
                    {' '}
                    <a href={f.link.href} class="underline underline-offset-2 hover:text-accent">{f.link.label}</a>.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING ORNAMENT -->
  <div class="ornament py-16">❦ &nbsp; · &nbsp; ❦ &nbsp; · &nbsp; ❦</div>

</BaseLayout>
