---
// Homepage v3. The Live Session day-clock world is retired. The page is white
// paper; dark-navy panes are the artifacts. Every animation makes an argument:
//   §2 same prompt, two mornings — the thesis, side by side.
//   §3 the folder — interactive: click a vault file, preview swaps.
//   §4 it keeps itself current — a timeline that draws itself.
//   §5 type something — the existing TryTerminal, untouched.
// Reduced-motion collapses to static-final-complete; no-JS server-renders all.
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import WorksWith from '../components/WorksWith.astro';
import ChangelogPreview from '../components/ChangelogPreview.astro';
import TryTerminal from '../components/TryTerminal.astro';
import TerminalPane from '../components/panes/TerminalPane.astro';

// §3 — the vault files and their (sample) preview contents.
const vaultFiles = [
  {
    name: 'Identity.md',
    path: '~/ThinkOS/vault/05 Profile/Identity.md',
    lines: ['# Identity', '', 'Design lead at a product studio.', 'Plans first, plain language, no fluff.', 'Stack: Figma, Claude Code, GitHub.'],
  },
  {
    name: 'Current Focus.md',
    path: '~/ThinkOS/vault/01 Now/Current Focus.md',
    lines: ['# Current Focus — this week', '', '1. v2 ingestion pipeline — cut release', '2. Q3 hiring plan, draft Friday', '3. clear PR queue (T. + R.)'],
  },
  {
    name: 'Tasks.md',
    path: '~/ThinkOS/vault/01 Now/Tasks.md',
    lines: ['## Today', '', '- v2 release notes', '- 1:1 with Priya, 2pm'],
  },
  {
    name: 'Work Log.md',
    path: '~/ThinkOS/vault/01 Now/Work Log.md',
    lines: ['### 14:00 — acme-redesign', '- Edited 12 files', '- HEAD: a1b2c3d'],
  },
  {
    name: 'People.md',
    path: '~/ThinkOS/vault/03 People/People.md',
    lines: ['### Priya — eng lead, v2', '- prefers async, briefs by Thu'],
  },
  {
    name: 'Decisions.md',
    path: '~/ThinkOS/vault/04 Knowledge/Decisions.md',
    lines: ['## 2026-06-11 — API versioning', 'Version the API from day one.'],
  },
  {
    name: 'Learnings.md',
    path: '~/ThinkOS/vault/04 Knowledge/Learnings.md',
    lines: ['## Demos beat decks', 'Clients decide on the prototype.'],
  },
  {
    name: 'Projects/',
    path: '~/ThinkOS/vault/02 Projects/',
    lines: ['v2-ingestion/  acme-redesign/', 'q3-hiring/'],
  },
];

const trust = [
  {
    label: 'doesn\'t phone home',
    body: 'Local-first. Your files stay on disk, indexed locally. They leave only if you choose to sync — git, iCloud, Syncthing.',
  },
  {
    label: 'doesn\'t capture content',
    body: 'Capture records metadata — directories, file counts, a commit hash. Never file contents, never transcripts. Every entry is ledgered and undoable.',
  },
  {
    label: 'doesn\'t write silently',
    body: 'Conversational writes are confirmed with you. Claude asks once before logging a decision — it never captures silently.',
  },
];

const steps = [
  {
    marker: '[1/3]',
    title: 'Install',
    time: '~5 min',
    body: 'Paste the install prompt into a fresh Claude Code session. It clones the repo, asks five questions, runs the install.',
  },
  {
    marker: '[2/3]',
    title: 'Restart + authenticate',
    time: '~2 min',
    body: 'Quit and reopen Claude Code — commands and MCPs load on startup. Installed a bundle? Type /mcp and authorize each connector.',
  },
  {
    marker: '[3/3]',
    title: 'Continue, when you want',
    time: 'opt-in · ~15–30 min',
    body: 'Skip it and the vault still fills in from your real conversations — Claude proposes, you confirm. Or run /thinkos-continue to bulk-import in one sitting.',
  },
];

const faqs = [
  {
    q: 'What do I actually do day to day?',
    a: 'One command in the morning (/thinkos-morning), a one-line capture when you make a decision worth keeping, and a twenty-minute /weekly-review on Sunday — the rest happens on its own. The full rhythm, dos and don\'ts included, is in',
    link: { href: '/guide', label: 'How to use it' },
  },
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Why markdown files instead of a vector or graph database?',
    a: 'You don\'t have to choose — Basic Memory derives full-text search, local embeddings, and a knowledge graph FROM your files, so retrieval is database-grade and the files stay auditable and editable anywhere. The long version is in docs/why-files-not-a-database.md on GitHub.',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory is free and local. The scheduled jobs run on your machine; only the weekly review, quarterly archive, and morning brief spawn a Claude session, which uses your existing Claude plan or API billing.',
  },
  {
    q: 'Which agent surfaces does Think OS support?',
    a: 'Claude Code is the first surface — full feature set: slash commands, autonomous launchd capture, drift-aware updates, vault health, cross-machine sync. Cowork and Codex live on the roadmap/cowork-codex branch and will be cherry-picked back in when their plugin formats stabilize. The vault itself is plain markdown plus a Basic Memory MCP — it works with any MCP-capable agent today (Claude Desktop, mobile, anywhere the MCP runs), you just lose the slash commands.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- ============================================================
       §1 · HERO — gentle fade-in stagger, no choreography
       ============================================================ -->
  <section class="play-on-load border-b border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-16 md:pt-24 pb-16 md:pb-24" style="min-height:78vh; display:flex; flex-direction:column; justify-content:center">
      <h1 class="display po-1 text-[clamp(44px,9vw,104px)] max-w-[15ch]">
        Stop being a stranger <em>every session.</em>
      </h1>

      <p class="po-2 mt-7 max-w-[58ch] text-[18px] md:text-[19px] leading-relaxed text-muted" style="font-variation-settings:'opsz' 16">
        Think OS is a folder of files Claude reads before it answers — your role,
        your projects, your people. Set it up once; it keeps itself current.
      </p>

      <div class="po-3 mt-10 max-w-[820px]">
        <InstallPrompt />
      </div>
      <p class="po-4 mt-6 font-mono text-[12px] tracking-[0.06em]">
        <a href="#same-prompt" class="link-anim text-accent">↓ watch the same prompt, two mornings</a>
      </p>
    </div>
  </section>

  <!-- ============================================================
       §2 · SAME PROMPT, TWO MORNINGS — the argument
       ============================================================ -->
  <section id="same-prompt" class="scene border-t border-rule" data-choreo>
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <div class="twin-grid">
        <!-- LEFT: without Think OS -->
        <div class="twin-cell">
          <TerminalPane label="claude code" tag="without think os"><span data-step="1"><span class="prompt">&gt;</span> <span class="cmd type-line" style="--type-ch:38ch; --type-steps:38">draft a standup update for the v2 project</span></span><span data-step="2" data-step-ms="700"><span class="line-stagger ls-gap" style="--d:0ms">Happy to help — a few questions first:</span><span class="line-stagger" style="--d:180ms">  · which project is the v2 project?</span><span class="line-stagger" style="--d:270ms">  · who reads this update?</span><span class="line-stagger" style="--d:360ms">  · what happened since the last one?</span></span></TerminalPane>
        </div>

        <!-- RIGHT: with Think OS -->
        <div class="twin-cell">
          <TerminalPane label="claude code" tag="with think os"><span data-step="1"><span class="prompt">&gt;</span> <span class="cmd type-line" style="--type-ch:38ch; --type-steps:38">draft a standup update for the v2 project</span></span><span data-step="3" data-step-ms="700"><span class="line-stagger ls-gap" style="--d:0ms">Standup — v2 ingestion pipeline:</span><span class="line-stagger" style="--d:180ms">  · release cut today; notes drafted</span><span class="line-stagger" style="--d:270ms">  · Q3 hiring plan: first draft Friday</span><span class="line-stagger" style="--d:360ms">  · PR queue clearing with T. + R.</span></span></TerminalPane>
        </div>
      </div>

      <p class="mt-10 text-[17px] md:text-[19px] leading-relaxed text-ink max-w-[58ch] step-fade" data-step="4" data-step-ms="500" style="font-variation-settings:'opsz' 17">
        Same prompt. The only difference is a folder of notes Claude read first.
      </p>
      <p class="mt-3 font-mono text-[10px] tracking-[0.16em] uppercase text-muted">
        Sample vault content — your real vault has your real notes.
      </p>
    </div>
  </section>

  <!-- ============================================================
       §3 · THE FOLDER — interactive moment 1
       ============================================================ -->
  <section class="scene border-t border-rule" data-choreo>
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-12 reveal">
        <h2 class="md-heading">Where it comes from</h2>
      </header>

      <div class="folder-grid" data-folder>
        <!-- LEFT: the vault panel (light card, NOT a pane) -->
        <div class="vault-panel" data-step="1">
          <p class="font-mono text-[11px] tracking-[0.08em] text-muted mb-4">~/ThinkOS/vault</p>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Preview a vault file">
            {vaultFiles.map((f, i) => (
              <>
                <button
                  type="button"
                  class="keycap vault-chip"
                  data-folder-chip={f.name}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >{f.name}</button>
                <span class="vault-chip-static keycap" aria-hidden="true">{f.name}</span>
              </>
            ))}
          </div>
        </div>

        <!-- RIGHT: preview pane (dark artifact) -->
        <div class="pane preview-pane" data-step="2">
          <div class="pane-bar">
            <span class="pane-path" data-folder-path>{vaultFiles[0].path}</span>
            <span class="pane-tag" data-kind="read">preview</span>
          </div>
          <pre class="pane-body whitespace-pre-wrap break-words" data-folder-body>{vaultFiles[0].lines.join('\n')}</pre>
        </div>
      </div>

      <p class="mt-8 text-[15px] leading-relaxed text-muted max-w-[60ch]">
        Plain markdown on your disk. Open any of it in Obsidian or TextEdit — it's yours.
      </p>
    </div>
  </section>

  <!-- ============================================================
       §4 · IT KEEPS ITSELF CURRENT — timeline that draws itself
       ============================================================ -->
  <section class="scene border-t border-rule" data-choreo>
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-12 reveal">
        <h2 class="md-heading">It keeps itself current</h2>
      </header>

      <div class="rail">
        <!-- Card 1 -->
        <article class="rail-card" data-step="1">
          <p class="rail-tag">08:40 · you type one command</p>
          <div class="pane">
            <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt">&gt;</span> good morning
<span class="dim">→ this week's top 3, today's plate</span></pre>
          </div>
        </article>

        <div class="rail-link" aria-hidden="true" data-step="2" data-step-ms="420"><span class="rail-line"></span></div>

        <!-- Card 2 -->
        <article class="rail-card" data-step="3">
          <p class="rail-tag">during the day · you type nothing</p>
          <div class="pane">
            <pre class="pane-body whitespace-pre-wrap break-words"><span class="diff-add">Work Log.md  +3 lines</span>
<span class="dim">folders · file counts · commit hash</span>
<span class="dim">never content</span></pre>
          </div>
        </article>

        <div class="rail-link" aria-hidden="true" data-step="4" data-step-ms="420"><span class="rail-line"></span></div>

        <!-- Card 3 -->
        <article class="rail-card" data-step="5">
          <p class="rail-tag">sun 20:00 · twenty minutes</p>
          <div class="pane">
            <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt">&gt;</span> /weekly-review
<span class="dim">→ Current Focus rewritten for next week</span></pre>
          </div>
        </article>
      </div>

      <p class="mt-10 text-[15px] leading-relaxed text-muted max-w-[60ch]">
        One command in the morning, one on Sunday. Capture runs in the background — metadata only.
      </p>
    </div>
  </section>

  <!-- ============================================================
       §5 · TYPE SOMETHING — existing TryTerminal, untouched
       ============================================================ -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-10">
        <h2 class="md-heading">Type something</h2>
      </header>
      <div class="max-w-[820px]">
        <TryTerminal />
      </div>
    </div>
  </section>

  <!-- ============================================================
       §6 · WHAT IT DOESN'T DO — light trust cards
       ============================================================ -->
  <section class="scene border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-14 reveal">
        <h2 class="md-heading">What it doesn't do</h2>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {trust.map((t) => (
          <article class="trust-card p-7 md:p-8">
            <p class="font-mono text-[14px] text-ink">
              <span class="text-accent">&gt; </span>{t.label}
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-muted max-w-[44ch]" style="font-variation-settings:'opsz' 15">{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKS WITH -->
  <WorksWith />

  <!-- ============================================================
       §7 · GET STARTED
       ============================================================ -->
  <section class="scene border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-14 reveal">
        <h2 class="md-heading">Get started</h2>
        <p class="mt-5 text-[16px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
          Fifteen to thirty minutes, once. After that it fills itself in.
        </p>
      </header>

      <div class="setup-card max-w-[860px]">
        <div class="setup-bar">
          <span class="font-mono text-[10px] tracking-[0.12em] uppercase text-muted">setup — 3 steps</span>
        </div>
        <div class="p-6 md:p-8 space-y-8">
          {steps.map((s, i) => (
            <div class="reveal" style={`--reveal-delay: ${i * 150}ms`}>
              <p class="font-mono text-[13px] mb-2">
                <span class="text-accent">{s.marker}</span>
                <span class="text-ink"> {s.title}</span>
                <span class="text-muted"> — {s.time}</span>
              </p>
              <p class="text-[16px] leading-relaxed text-muted max-w-[60ch]" style="font-variation-settings:'opsz' 16">
                {s.body}
                {i === 2 && (<>
                  {' '}Then read <a href="/guide" class="underline underline-offset-2 text-ink hover:text-accent"><strong>How to use it</strong></a> →
                </>)}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 max-w-[820px] reveal">
        <InstallPrompt />
      </div>
      <div class="mt-6 max-w-[820px] reveal">
        <ChangelogPreview />
      </div>
    </div>
  </section>

  <!-- ============================================================
       §8 · QUESTIONS + CLOSE
       ============================================================ -->
  <section class="scene border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-12 reveal">
        <h2 class="md-heading">Questions</h2>
      </header>

      <div class="grid grid-cols-12 gap-6 reveal">
        <div class="col-span-12 md:col-span-9 lg:col-span-8">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="faq-body">
                {f.a}
                {f.link && (
                  <>
                    {' '}
                    <a href={f.link.href} class="underline underline-offset-2 hover:text-accent">{f.link.label}</a>.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>

      <div class="mt-16 reveal">
        <p class="display font-bold text-[28px] md:text-[36px] leading-tight max-w-[24ch]" style="font-variation-settings:'opsz' 36">
          A markdown vault that travels with you, between agents.
        </p>
        <p class="mt-7 font-mono text-[12px] tracking-[0.08em]">
          <a href="#main" class="link-anim text-muted">Install ↑</a>
          <span class="mx-3 text-muted opacity-50">·</span>
          <a href="/guide" class="link-anim text-muted">How to use it →</a>
          <span class="mx-3 text-muted opacity-50">·</span>
          <a href="/commands" class="link-anim text-muted">All 36 commands →</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* §2 twin grid — two panes side by side, no connector. */
  .twin-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .twin-cell { min-width: 0; }
  @media (min-width: 900px) {
    .twin-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }

  /* §3 folder grid — vault panel + preview pane. */
  .folder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .folder-grid { grid-template-columns: 0.85fr 1.15fr; gap: 2rem; }
  }
  .vault-panel {
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .preview-pane { min-width: 0; }
  .preview-pane .pane-body { min-height: 9.5rem; }

  /* No-JS: chips become inert static spans; live buttons hidden. */
  html:not(.js) .folder-grid [data-folder-chip] { display: none; }
  html.js .folder-grid .vault-chip-static { display: none; }

  /* Brief highlight sweep when a preview swaps (JS adds .preview-flash). */
  .preview-pane.preview-flash .pane-body {
    animation: preview-sweep 460ms cubic-bezier(0.2, 0.7, 0.2, 1) 1;
  }
  @keyframes preview-sweep {
    0%   { background-color: rgb(var(--pane-accent-rgb) / 0.12); }
    100% { background-color: transparent; }
  }

  /* §4 timeline rail — horizontal on desktop, vertical on mobile. */
  .rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
  }
  .rail-card { min-width: 0; }
  .rail-tag {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .rail-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
  }
  .rail-link::before {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background: var(--rule);
  }
  /* The drawing line — accent overlay grows when its step turns on. */
  .rail-line {
    position: absolute;
    width: 1px;
    height: 100%;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 50% 0;
    background-size: 1px 100%;
  }
  @media (min-width: 900px) {
    .rail {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
    }
    .rail-link { height: auto; width: 2.5rem; }
    .rail-link::before { width: 100%; height: 1px; }
    .rail-line {
      width: 100%;
      height: 1px;
      background-position: 0 50%;
      background-size: 100% 1px;
    }
  }

  /* Rail line draws when its step turns on (motion only). Base: not drawn. */
  html.reveal-ready [data-choreo] .rail-line { background-size: 0% 1px; }
  @media (max-width: 899px) {
    html.reveal-ready [data-choreo] .rail-line { background-size: 1px 0%; }
  }
  html.reveal-ready [data-choreo] [data-step].step-on .rail-line {
    background-size: 100% 1px;
    transition: background-size 400ms ease;
  }
  @media (max-width: 899px) {
    html.reveal-ready [data-choreo] [data-step].step-on .rail-line {
      background-size: 1px 100%;
    }
  }

  /* §6 trust cards + §7 setup card — light cards with rule borders. */
  .trust-card,
  .setup-card {
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .setup-bar {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  /* Reduced-motion: rail line is fully drawn, no preview sweep. */
  @media (prefers-reduced-motion: reduce) {
    html.reveal-ready [data-choreo] .rail-line,
    html.reveal-ready [data-choreo] [data-step].step-on .rail-line {
      background-size: 100% 1px !important;
      transition: none;
    }
    .preview-pane.preview-flash .pane-body { animation: none; }
  }
</style>

<script is:inline>
  // §3 — the folder. Clicking a chip swaps the preview pane content + path
  // and runs a brief highlight sweep. Keyboard: chips are real buttons;
  // selected chip aria-pressed="true". No-JS: chips are inert spans, preview
  // stays on Identity.md (server-rendered). Reduced-motion: no sweep.
  (function () {
    var root = document.querySelector('[data-folder]');
    if (!root) return;
    var dataEl = document.querySelector('[data-folder-data]');
    var files;
    try { files = JSON.parse(dataEl.textContent); } catch (e) { return; }

    var chips = Array.prototype.slice.call(root.querySelectorAll('[data-folder-chip]'));
    var bodyEl = root.querySelector('[data-folder-body]');
    var pathEl = root.querySelector('[data-folder-path]');
    var pane = root.querySelector('.preview-pane');
    var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function byName(name) {
      for (var i = 0; i < files.length; i++) if (files[i].name === name) return files[i];
      return files[0];
    }

    function select(name) {
      var f = byName(name);
      chips.forEach(function (c) {
        c.setAttribute('aria-pressed', c.getAttribute('data-folder-chip') === name ? 'true' : 'false');
      });
      bodyEl.textContent = f.lines.join('\n');
      pathEl.textContent = f.path;
      if (motion && pane) {
        pane.classList.remove('preview-flash');
        // force reflow so the sweep restarts
        void pane.offsetWidth;
        pane.classList.add('preview-flash');
      }
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        select(chip.getAttribute('data-folder-chip'));
      });
    });
  })();
</script>

<script
  type="application/json"
  data-folder-data
