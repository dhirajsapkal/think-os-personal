---
// Homepage v2 — "Live Session". The site IS a running terminal session viewed
// at night. The day advances as you scroll; commands type themselves as scenes
// enter; diffs write line-by-line; two genuinely interactive moments.
//
// All copy verified against the v0.9.5 inventory (index/DayPairs/guide/commands)
// or the shipped playbooks. Restaged, not rewritten.
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import WorksWith from '../components/WorksWith.astro';
import ChangelogPreview from '../components/ChangelogPreview.astro';
import CommandStage from '../components/CommandStage.astro';
import TryTerminal from '../components/TryTerminal.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import Pair from '../components/Pair.astro';
import TerminalPane from '../components/panes/TerminalPane.astro';
import FilePane from '../components/panes/FilePane.astro';
import DiffPane from '../components/panes/DiffPane.astro';
import { VERSION } from '../lib/version';

const flowNodes = [
  {
    label: 'your files',
    body: 'A plain folder on your disk — <code>~/ThinkOS/vault</code>. Who you are, what you\'re doing this week, your projects, people, decisions, and a running work log. Open any of them in Obsidian, VS Code, or TextEdit. Nothing is hidden, encoded, or locked in.',
  },
  {
    label: 'a local index',
    body: 'Basic Memory derives a hybrid index from your files — SQLite full-text search, local vector embeddings, and a knowledge graph built from your notes\' own links. The index is a copy of your files, not the other way around. If it breaks, one command rebuilds it.',
  },
  {
    label: 'every session',
    body: 'Search locates; the agent reads only the span it needs. Large files are never read end to end.',
  },
];

const trust = [
  {
    label: 'doesn\'t phone home',
    body: 'Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    label: 'doesn\'t capture content',
    body: 'The background job records session metadata: directories, file counts, a commit hash. Not file contents, not transcripts, not anything you typed. It runs locally, makes no network calls, and every entry is listed in the ledger and removable with /thinkos-undo-capture.',
  },
  {
    label: 'doesn\'t write silently',
    body: 'Conversational writes are confirmed with you; automatic captures are metadata-only, ledger-logged, and undoable. When you state a reusable decision mid-conversation, Claude asks once whether to log it — it won\'t capture silently.',
  },
];

const steps = [
  {
    marker: '[1/3]',
    title: 'Install',
    time: '~5 min',
    body: 'Paste the install prompt into a fresh Claude Code session. The agent clones the repo, asks five questions, and runs the install.',
  },
  {
    marker: '[2/3]',
    title: 'Restart + authenticate',
    time: '~2 min',
    body: 'Quit Claude Code and reopen it. MCPs and new slash commands only load on startup. If you installed a plugin bundle, type /mcp and authorize each connector listed.',
  },
  {
    marker: '[3/3]',
    title: 'Continue, when you want',
    time: 'opt-in · ~15–30 min',
    body: 'Skip this and the vault still fills in — emergent seeding watches your real conversations and proposes entries you confirm. Or run /thinkos-continue to bulk-seed: import an existing markdown vault, pull from your connected tools, and draft Identity, Project Index, Current Focus, and People in one sitting.',
  },
];

const faqs = [
  {
    q: 'What do I actually do day to day?',
    a: 'One command in the morning (/thinkos-morning), a one-line capture when you make a decision worth keeping, and a twenty-minute /weekly-review on Sunday — the rest happens on its own. The full rhythm, dos and don\'ts included, is in',
    link: { href: '/guide', label: 'How to use it' },
  },
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Why markdown files instead of a vector or graph database?',
    a: 'You don\'t have to choose. Basic Memory derives a hybrid index from your files — SQLite full-text search, local vector embeddings, and a knowledge graph built from your notes\' own links — so you get database-grade retrieval without giving up the files. DB-native memory systems run an LLM over every write to extract "facts," which costs tokens and bakes mistakes into the store; verbatim markdown stays auditable, git-diffable, and editable anywhere. The long version, tradeoffs included, is in docs/why-files-not-a-database.md on GitHub.',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory itself is free and runs locally — no cloud mode, no recurring infrastructure cost. Phase 3 maintenance jobs run as local launchd jobs. The daily reindex uses no API tokens. The weekly review, quarterly archive, and morning brief each spawn a local claude session when they fire — those consume Anthropic API tokens; whether that\'s included in your Claude subscription or charged as pay-as-you-go depends on your account.',
  },
  {
    q: 'Which agent surfaces does Think OS support?',
    a: 'Claude Code is the first surface — full feature set: slash commands, autonomous launchd capture, drift-aware updates, vault health, cross-machine sync. Cowork and Codex live on the roadmap/cowork-codex branch and will be cherry-picked back in when their plugin formats stabilize. The vault itself is plain markdown plus a Basic Memory MCP — it works with any MCP-capable agent today (Claude Desktop, mobile, anywhere the MCP runs), you just lose the slash commands.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- ============================================================
       SCENE 1 · BOOT (08:38) — pure CSS, plays on load, no observer
       ============================================================ -->
  <section class="play-on-load border-b border-rule" data-time="08:38">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-14 md:pt-20 pb-16 md:pb-24" style="min-height:88vh; display:flex; flex-direction:column; justify-content:center">

      <!-- borderless boot region — the room itself -->
      <pre class="font-mono text-[13px] md:text-[14px] leading-[1.9] text-ink m-0 whitespace-pre-wrap"><span class="prompt">$</span> <span class="cmd type-line" style="--type-ch:7ch; --type-steps:7; --type-start:220ms">claude</span><span class="po-1 block text-muted">thinkos v{VERSION} · vault mounted · 2 files read</span></pre>

      <h1 class="display po-2 mt-9 text-[clamp(44px,9vw,116px)] max-w-[14ch]">
        Stop being a stranger <em>every session.</em>
      </h1>

      <p class="po-3 mt-7 max-w-[62ch] text-[18px] md:text-[19px] leading-relaxed text-muted" style="font-variation-settings:'opsz' 16">
        Think OS is a folder of markdown files Claude reads at the start of
        every session — so it knows your role, your week, your people, your
        decisions, without you re-typing them.
      </p>

      <div class="po-4 mt-10 max-w-[820px]">
        <InstallPrompt />
      </div>
      <p class="po-4 mt-6 font-mono text-[12px] tracking-[0.06em]">
        <a href="#scene-read" class="link-anim text-accent">↓ watch a day with it</a>
      </p>
    </div>
  </section>

  <!-- ============================================================
       SCENE 2 · THE READ (08:40)
       ============================================================ -->
  <section id="scene-read" class="scene border-t border-rule" data-time="08:40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <Pair>
        <TerminalPane slot="left" label="claude code" tag="08:40"><span class="prompt">&gt;</span> <span class="cmd type-line" style="--type-ch:13ch; --type-steps:13; --type-start:200ms">good morning</span><span class="after-type">

This week (top 3):
  1. v2 ingestion pipeline — cut release
  2. Q3 hiring plan, first draft Friday
  3. clear PR queue (T. + R.)

Calendar: 2 meetings, both afternoon.</span></TerminalPane>
        <FilePane slot="right" path="~/ThinkOS/vault/" tag="read"><span class="after-type"><span class="dim">00 Home/</span>
<span class="dim">01 Now/</span>
<span class="read-row">  <span class="text-accent">Current Focus.md</span>  <span class="dim">← read</span></span>
<span class="dim">  Tasks.md</span>
<span class="dim">  Work Log.md</span>
<span class="dim">02 Projects/</span>
<span class="dim">03 People/</span>
<span class="dim">04 Knowledge/</span>
<span class="dim">05 Profile/</span>
<span class="read-row">  <span class="text-accent">Identity.md</span>  <span class="dim">← read</span></span>
<span class="dim">90 System/</span></span></FilePane>
      </Pair>
      <p class="mt-6 text-[15px] leading-relaxed text-muted max-w-[64ch]">
        At the start of a session, Claude reads two small files — your Identity
        and this week's Current Focus. Both are small, so it reads them whole.
        That's the entire trick.
      </p>
      <p class="mt-3 font-mono text-[10px] tracking-[0.16em] uppercase text-muted">
        Sample vault content — your real vault has your real notes.
      </p>
    </div>
  </section>

  <!-- ============================================================
       SCENE 3 · YOU TYPED NOTHING (14:02)
       ============================================================ -->
  <section class="scene border-t border-rule" data-time="14:02">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <Pair>
        <TerminalPane slot="left" label="claude code" tag="14:02"><span class="dim">— no session open —</span></TerminalPane>
        <DiffPane slot="right" path="01 Now / Work Log.md" tag="+3 lines"><span class="dim"># appended by session capture</span>

<span class="diff-add" style="--d:0ms">+ ### 14:00 — acme-redesign</span>
<span class="diff-add" style="--d:80ms">+ - Edited 12 files in ~/code/acme-redesign</span>
<span class="diff-add" style="--d:160ms">+ - HEAD: a1b2c3d</span>

<span class="dim"># listed in the ledger; removable</span>
<span class="dim"># with /thinkos-undo-capture</span></DiffPane>
      </Pair>
      <p class="mt-6 text-[15px] leading-relaxed text-muted max-w-[58ch]">
        The background job noted where the morning went — folders, file
        counts, a commit hash. Never content.
      </p>
    </div>
  </section>

  <!-- ============================================================
       SCENE 4 · COMMAND STAGE — interactive moment 1
       ============================================================ -->
  <section class="border-t border-rule" data-time="08:40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <CommandStage />
    </div>
  </section>

  <!-- ============================================================
       SCENE 5 · HOW IT WORKS
       ============================================================ -->
  <section class="scene border-t border-rule" data-time="09:15">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-12 reveal">
        <h2 class="md-heading">How it works</h2>
      </header>

      <FlowDiagram nodes={flowNodes} />

      <div class="mt-12 reveal">
        <p class="md-quote max-w-[40ch]">
          Markdown is the source of truth. Everything else is a rebuildable index.
        </p>
        <p class="mt-5 text-[15px] leading-relaxed text-muted max-w-[60ch]">
          The why, tradeoffs included →
          <a href="/docs/architecture" class="underline underline-offset-2 hover:text-accent">/docs/architecture</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SCENE 6 · TRY IT — interactive moment 2
       ============================================================ -->
  <section class="border-t border-rule" data-time="11:30">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-10">
        <h2 class="md-heading">Try it</h2>
      </header>
      <div class="max-w-[820px]">
        <TryTerminal />
      </div>
    </div>
  </section>

  <!-- ============================================================
       SCENE 7 · WHAT IT DOESN'T DO
       ============================================================ -->
  <section class="scene border-t border-rule" data-time="13:00">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-14 reveal">
        <h2 class="md-heading">What it doesn't do</h2>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {trust.map((t) => (
          <article class="pane p-7 md:p-8">
            <p class="font-mono text-[14px] text-ink">
              <span class="text-muted">&gt; </span>{t.label}
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-muted max-w-[44ch]" style="font-variation-settings:'opsz' 15">{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKS WITH -->
  <WorksWith />

  <!-- ============================================================
       SCENE 8 · GET STARTED
       ============================================================ -->
  <section class="scene border-t border-rule" data-time="15:00">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-14 reveal">
        <h2 class="md-heading">Get started</h2>
        <p class="mt-5 text-[16px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
          About fifteen to thirty minutes once. Zero overhead after — the vault
          fills in from your real conversations, not a long Q&A.
        </p>
      </header>

      <div class="pane max-w-[860px]">
        <div class="pane-bar">
          <span class="pane-path">setup — queued</span>
          <span class="pane-tag" data-kind="read">3 steps</span>
        </div>
        <div class="p-6 md:p-8 space-y-8">
          {steps.map((s, i) => (
            <div class="reveal" style={`--reveal-delay: ${i * 150}ms`}>
              <p class="font-mono text-[13px] mb-2">
                <span class="text-accent">{s.marker}</span>
                <span class="text-ink"> {s.title}</span>
                <span class="text-muted"> — {s.time}</span>
              </p>
              <p class="text-[16px] leading-relaxed text-muted max-w-[60ch]" style="font-variation-settings:'opsz' 16">
                {s.body}
                {i === 2 && (<>
                  {' '}Then read <a href="/guide" class="underline underline-offset-2 text-ink hover:text-accent"><strong>How to use it</strong></a> →
                </>)}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 max-w-[820px] reveal">
        <InstallPrompt />
      </div>
      <div class="mt-6 max-w-[820px] reveal">
        <ChangelogPreview />
      </div>
    </div>
  </section>

  <!-- ============================================================
       SCENE 9 · QUESTIONS + CLOSE
       ============================================================ -->
  <section class="scene border-t border-rule" data-time="20:14" data-day="sun">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="mb-12 reveal">
        <h2 class="md-heading">Questions</h2>
      </header>

      <div class="grid grid-cols-12 gap-6 reveal">
        <div class="col-span-12 md:col-span-9 lg:col-span-8">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="faq-body">
                {f.a}
                {f.link && (
                  <>
                    {' '}
                    <a href={f.link.href} class="underline underline-offset-2 hover:text-accent">{f.link.label}</a>.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>

      <div class="mt-16 reveal">
        <p class="display font-bold text-[28px] md:text-[36px] leading-tight max-w-[24ch]" style="font-variation-settings:'opsz' 36">
          A markdown vault that travels with you, between agents.
        </p>
        <p class="mt-7 font-mono text-[12px] tracking-[0.08em]">
          <a href="#main" class="link-anim text-muted">Install ↑</a>
          <span class="mx-3 text-muted opacity-50">·</span>
          <a href="/guide" class="link-anim text-muted">How to use it →</a>
          <span class="mx-3 text-muted opacity-50">·</span>
          <a href="/commands" class="link-anim text-muted">All 36 commands →</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
