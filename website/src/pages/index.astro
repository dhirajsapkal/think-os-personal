---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import ConversationStrip from '../components/ConversationStrip.astro';
import VaultTree from '../components/VaultTree.astro';
import TrustBar from '../components/TrustBar.astro';
import WorksWith from '../components/WorksWith.astro';
import ChangelogPreview from '../components/ChangelogPreview.astro';

const benefits = [
  {
    n: '01',
    title: 'Continuity',
    body: 'Every agent session loads who you are, what you\'re on, and how you work — without you re-typing context. The first message in a new chat already knows the room.',
  },
  {
    n: '02',
    title: 'Cross-project recall',
    body: '"What did I learn about X that applies to Y" actually works. Decisions and learnings live next to the projects they came from but surface across all of them.',
  },
  {
    n: '03',
    title: 'A capture habit',
    body: 'When you make a reusable decision or share a learning, the agent offers to log it — you confirm, it writes. Six months later, search finds it.',
  },
  {
    n: '04',
    title: 'Self-maintenance',
    body: 'Local launchd jobs keep the vault fresh: daily reindex, weekly Current Focus refresh, quarterly archive rotation — and a session-start check that flags an expired Current Focus before you ask. Runs when your Mac is awake; no cloud dependency.',
  },
  {
    n: '05',
    title: 'Light on tokens',
    body: 'Sessions run 50–70% lighter as of v0.9.3. The instruction stack stays lean, large files are read in scoped spans instead of end-to-end, and search snippets locate — they never substitute for reading the source.',
  },
];

const installed = [
  {
    n: '01',
    title: 'Curated agent guidance',
    body: 'A curated instruction stack drops into the agent\'s always-loaded context — kept deliberately lean, with heavyweight playbooks loading on demand instead of riding along in every session. Consult the vault first. Draft, never send. Cite path:line. Never commit secrets. Refreshable in place with /thinkos-update.',
  },
  {
    n: '02',
    title: 'Thirty-six slash commands',
    body: 'Pre-built playbooks for daily flows: /thinkos-morning, /thinkos-plate, /thinkos-capture, /thinkos-who, /thinkos-vitals, /thinkos-sync, /thinkos-update. Each is a plain markdown file at ~/.claude/commands/ — auditable, editable, yours. Full list in § VII.',
  },
  {
    n: '03',
    title: 'Role-based bundles',
    body: 'Pick one preset and the right MCPs install for you: PM (Slack + Gmail + Google Calendar + Google Drive + Notion + Granola + Figma), Engineering (Slack + Gmail + Google Calendar + Google Drive + Atlassian), Design (Slack + Gmail + Google Calendar + Google Drive + Notion + Figma + Granola), Operations (Slack + Gmail + Google Calendar + Notion + QuickBooks). Each pulls matching Anthropic skill packs too.',
  },
  {
    n: '04',
    title: 'Skill routing baked in',
    body: 'The instructions teach the agent which Anthropic skill to invoke for which task. UI work routes to frontend-design. PR review to review. Security audits to security-review. SDK code to claude-api. You ask in plain English; the agent picks the right tool.',
  },
  {
    n: '05',
    title: 'Three-vault privacy model',
    body: 'Personal hub (local-only, never shared). Project vaults (shared via git, schema-enforced). Reference vaults (read-only imports). Personal content stays out of team repos by structural design — project vault schemas physically don\'t accept it. Privacy as architecture, not policy.',
  },
  {
    n: '06',
    title: 'Self-healing onboarding',
    body: 'If anything in setup feels off — wrong command, missing step, confusing prompt — tell the agent. It opens a PR upstream so the next person doesn\'t hit it. The install gets better every time someone runs it. (Gated on gh CLI being authenticated.)',
  },
];

const rules = [
  {
    n: 'I',
    title: 'Files are the source of truth.',
    body: 'Tool memory, the Basic Memory index, and any tool-specific cache are derivatives. The markdown on disk is canonical.',
  },
  {
    n: 'II',
    title: 'Always-loaded context stays small.',
    body: 'Identity and this week\'s focus load verbatim — they\'re small, and verbatim reads are the grounding. Everything bigger is searched first, then read in scoped spans. Nothing rides along in every session unless it earns the tokens.',
  },
  {
    n: 'III',
    title: 'Personal stays personal. Team stays team.',
    body: 'Your private notes live in a vault only you can see. Project work lives in a separate vault shared with your team. The structure makes accidental crossover impossible.',
  },
];

// § V — the architecture argument, grounded in the v0.9.3 research pass.
const architecture = [
  {
    n: '01',
    title: 'Against context-stuffing',
    body: 'Whole-file injection of large files is the documented accuracy killer — irrelevant tokens crowd out the question. So large files are never read end-to-end: the work log is extracted by date window, tasks by section, the capture ledger by tail. Search locates; the agent reads only the span it needs.',
  },
  {
    n: '02',
    title: 'Against DB-native memory',
    body: 'Memory systems that extract "facts" into a store pay an LLM toll on every write and inherit its mistakes forever. Here, writes are deterministic — nothing is paraphrased on the way in. The index is a disposable cache: corrupt it, delete it, rebuild it from the files. Your notes stay git-diffable and readable in any editor.',
  },
  {
    n: '03',
    title: 'Freshness is mechanical',
    body: 'A session-start check flags a stale Current Focus the moment a session opens — one line, enforced by the harness rather than by hoping the model remembers. The doctor compares index row counts against the files on disk and points you at the one-command rebuild when they drift.',
  },
];

const faqs = [
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Why markdown files instead of a vector or graph database?',
    a: 'You don\'t have to choose. Basic Memory derives a hybrid index from your files — SQLite full-text search, local vector embeddings, and a knowledge graph built from your notes\' own links — so you get database-grade retrieval without giving up the files. DB-native memory systems run an LLM over every write to extract "facts," which costs tokens and bakes mistakes into the store; verbatim markdown stays auditable, git-diffable, and editable anywhere. The long version, tradeoffs included, is in docs/why-files-not-a-database.md on GitHub.',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory itself is free and runs locally — no cloud mode, no recurring infrastructure cost. Phase 3 maintenance jobs run as local launchd jobs. The daily reindex uses no API tokens. The weekly review, quarterly archive, and morning brief each spawn a local claude session when they fire — those consume Anthropic API tokens; whether that\'s included in your Claude subscription or charged as pay-as-you-go depends on your account.',
  },
  {
    q: 'Which agent surfaces does Think OS support?',
    a: 'Claude Code is the first surface — full feature set: slash commands, autonomous launchd capture, drift-aware updates, vault health, cross-machine sync. Cowork and Codex live on the roadmap/cowork-codex branch and will be cherry-picked back in when their plugin formats stabilize. The vault itself is plain markdown plus a Basic Memory MCP — it works with any MCP-capable agent today (Claude Desktop, mobile, anywhere the MCP runs), you just lose the slash commands.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- HERO -->
  <section class="wash-hero">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 pt-20 md:pt-28 pb-24 md:pb-36">
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-2">
          <div class="lift lift-1">
            <a
              href="https://thinkcompany.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[10px] tracking-[0.18em] uppercase text-muted hover:text-accent transition-colors"
            >
              A project from Think Company
            </a>
          </div>

          <h1 class="display lift lift-2 mt-8 text-[44px] md:text-[88px] lg:text-[104px] tracking-tightest">
            Personal context<br />
            that follows you<br />
            into <em>every agent session.</em>
          </h1>

          <p class="lift lift-3 mt-10 md:mt-12 max-w-[58ch] text-[17px] md:text-[19px] leading-relaxed text-muted">
            Your agent knows who you are before you say a word — your role, what
            you're on this week, how you like to be written to. A markdown vault
            on your disk, surfaced through a context MCP server, loaded into
            every Claude Code session.
          </p>

          <div class="lift lift-4 mt-12 max-w-[820px]">
            <InstallPrompt />
          </div>

          <div class="lift lift-5 mt-6 max-w-[820px]">
            <ChangelogPreview />
          </div>

          <div class="lift lift-6 mt-10 max-w-[820px]">
            <TrustBar />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONVERSATION STRIP -->
  <ConversationStrip />

  <!-- BENEFITS / WHAT YOU GET -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">I</p>
          <p class="kicker mt-5">§ I</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">What you get</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Not another note-taking app. Five concrete behaviors that change how
            you work with an agent.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-14">
        {benefits.map((b, i) => (
          <div
            class="col-span-12 md:col-span-6 grid grid-cols-12 gap-4 md:gap-6 reveal"
            style={`--reveal-delay: ${(i % 2) * 90}ms`}
          >
            <div class="col-span-3 md:col-span-2">
              <p class="numeral text-4xl md:text-5xl leading-none">{b.n}</p>
            </div>
            <div class="col-span-9 md:col-span-10">
              <h3 class="font-display text-xl md:text-2xl tracking-tight">{b.title}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted max-w-[42ch]">
                {b.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT IN — what actually installs -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">II</p>
          <p class="kicker mt-5">§ II</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Built in</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Think OS isn't just a folder of markdown. Installing it drops a curated
            agent instruction stack, thirty-six pre-built playbooks, a role-based MCP
            bundle, and skill routing into your environment. Every agent that touches
            the vault knows what to do without you teaching it.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-14">
        {installed.map((b, i) => (
          <div
            class="col-span-12 md:col-span-6 grid grid-cols-12 gap-4 md:gap-6 reveal"
            style={`--reveal-delay: ${(i % 2) * 90}ms`}
          >
            <div class="col-span-3 md:col-span-2">
              <p class="numeral text-4xl md:text-5xl leading-none">{b.n}</p>
            </div>
            <div class="col-span-9 md:col-span-10">
              <h3 class="font-display text-xl md:text-2xl tracking-tight">{b.title}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted max-w-[42ch]">
                {b.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SETUP IS THREE STEPS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">III</p>
          <p class="kicker mt-5">§ III</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Setup</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            About fifteen to thirty minutes once. Zero overhead after — the
            vault fills in from your real conversations, not a long Q&A. Bulk
            seeding from your connected tools is opt-in, not required.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-12">
        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:pr-8 reveal">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 1</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~5 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Install</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Paste the install prompt into a fresh Claude Code session. The agent
            clones the repo, asks four questions (vault location, Basic Memory,
            plugin bundle, vault name), optionally offers capability add-ons
            (Playwright browser capture, GitHub CLI auth), and runs the install.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:px-8 reveal" style="--reveal-delay: 90ms">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 2</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~2 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Restart + authenticate</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Quit Claude Code and reopen it. MCPs and new slash commands only
            load on startup.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            If you installed a plugin bundle, type
            <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/mcp</code> and
            authorize each connector listed.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:pl-8 reveal" style="--reveal-delay: 180ms">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 3 — opt-in</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~15–30 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Continue, when you want</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Skip this and the vault still fills in — emergent seeding watches
            your real conversations and proposes entries you confirm. Or run
            <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/thinkos-continue</code>
            to bulk-seed: import an existing markdown vault, pull from your
            connected tools (Granola, Calendar, Slack, Gmail, Linear), and
            draft Identity, Project Index, Current Focus, and People in one
            sitting.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            At the end, three grouped questions wire up the capture layers: session capture, vault-maintenance triggers (daily reindex, weekly review, quarterly archive), and continuous-capture sources (Calendar by default; Granola, Slack, Gmail, Linear, ClickUp opt-in).
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- THREE RULES -->
  <section class="border-t border-rule bg-soft/40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">IV</p>
          <p class="kicker mt-5">§ IV</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Three rules</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            The architecture in one screen. If anything goes wrong, it'll be because
            one of these got violated.
          </p>
        </div>
      </header>

      <div class="space-y-10">
        {rules.map((r, i) => (
          <div
            class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8 reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="col-span-2 md:col-span-1">
              <span class="numeral text-3xl md:text-4xl">{r.n}</span>
            </div>
            <div class="col-span-10 md:col-span-6">
              <p class="font-display text-2xl md:text-3xl tracking-tight">{r.title}</p>
            </div>
            <div class="col-span-12 md:col-span-5">
              <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">{r.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FILES, NOT A DATABASE -->
  <section class="border-t border-rule wash-section">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-14 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">V</p>
          <p class="kicker mt-5">§ V</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Your files are <em>already</em> the database.</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[62ch]">
            Think OS doesn't read your whole vault into context, and it doesn't
            move your notes into a store you can't open. The vault is plain
            markdown on disk, fronted by Basic Memory's hybrid index — SQLite
            full-text search, vector embeddings computed locally with zero API
            calls, and a knowledge graph built from your notes' own links.
            Search runs against the index; every answer terminates in a
            verbatim read of the file itself.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="pullquote text-2xl md:text-[32px] max-w-[26ch]">
            Markdown is the source of truth. Everything else is a rebuildable index.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-x-6 gap-y-12">
        {architecture.map((a, i) => (
          <article
            class="col-span-12 md:col-span-4 border-t border-rule pt-6 reveal"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <p class="numeral text-3xl md:text-4xl leading-none">{a.n}</p>
            <h3 class="font-display text-xl md:text-2xl tracking-tight mt-4">{a.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted max-w-[46ch]">{a.body}</p>
          </article>
        ))}
      </div>

      <div class="grid grid-cols-12 gap-6 mt-14 reveal">
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[15px] leading-relaxed text-muted max-w-[62ch]">
            The full argument — including what dedicated vector and graph
            databases genuinely do better, and why none of it pays off at
            personal-vault scale — lives in
            <a
              href="https://github.com/dhirajsapkal/think-os/blob/main/docs/why-files-not-a-database.md"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-accent"
            >docs/why-files-not-a-database.md</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VAULT TYPES -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">VI</p>
          <p class="kicker mt-5">§ VI</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Vaults</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Three types, each with its own privacy model. Personal stays personal
            by construction — there's nowhere for it to leak into a shared repo.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule reveal">
        {[
          {
            name: 'Personal hub',
            kicker: 'Always local',
            body: 'Identity, current focus, decisions, learnings, people, private notes. Lives on your disk, never shared.',
          },
          {
            name: 'Project vault',
            kicker: 'Shared via git',
            body: 'Team activity, project decisions, specs. Privacy enforced structurally — the schema has no slot for personal content, so it can\'t leak.',
          },
          {
            name: 'Reference vault',
            kicker: 'Read-only import',
            body: 'A folder of someone else\'s markdown you want indexed for search. Marked [reference] in agent output. Never written to.',
          },
        ].map((v) => (
          <article class="bg-paper p-7 md:p-9 hover-card">
            <p class="kicker">{v.kicker}</p>
            <h3 class="font-display text-2xl md:text-[28px] mt-5 tracking-tight">{v.name}</h3>
            <p class="mt-5 text-[15px] leading-relaxed text-muted">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- VAULT TREE -->
  <VaultTree />

  <!-- COMMANDS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-12 reveal">
        <div class="col-span-12 md:col-span-3">
          <p class="section-numeral" aria-hidden="true">VII</p>
          <p class="kicker mt-5">§ VII</p>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <h2 class="display text-3xl md:text-5xl">Commands</h2>
          <p class="mt-5 text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Every Think OS slash command. Most are prefixed so they autocomplete
            as a group — type <code class="font-mono bg-soft px-1.5 py-0.5 rounded text-[13px]">/thinkos</code> in
            Claude Code and tab through the list.
          </p>
        </div>
      </header>

      <div class="space-y-14">
        {[
          {
            name: 'Morning ritual',
            intro: 'Start the day with one command. Calendar, focus, plate, recent log — in under fifteen seconds.',
            items: [
              ['/thinkos-morning',  'Daily brief — focus, plate, recent log, calendar'],
