---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';

const benefits = [
  {
    n: '01',
    title: 'Continuity',
    body: 'Every agent session loads who you are, what you\'re on, and how you work — without you re-typing context. The first message in a new chat already knows the room.',
  },
  {
    n: '02',
    title: 'Cross-project recall',
    body: '"What did I learn about X that applies to Y" actually works. Decisions and learnings live next to the projects they came from but surface across all of them.',
  },
  {
    n: '03',
    title: 'A capture habit',
    body: 'When you make a reusable decision or share a learning, the agent offers to log it — you confirm, it writes. Six months later, search finds it.',
  },
  {
    n: '04',
    title: 'Self-maintenance',
    body: 'Local launchd jobs keep the vault fresh: daily reindex, weekly Current Focus refresh, quarterly archive rotation. Runs when your Mac is awake — no cloud dependency, no remote infrastructure.',
  },
];

const installed = [
  {
    n: '01',
    title: 'Curated agent guidance',
    body: 'A five-file instruction stack drops into the agent\'s always-loaded context. Consult the vault first. Draft, never send. Plan before multi-file edits. Cite path:line. Surface freshness warnings. Never commit secrets. ~280 lines of distilled prompt engineering — refreshable in place with /thinkos-update.',
  },
  {
    n: '02',
    title: 'Twenty slash commands',
    body: 'Pre-built playbooks for daily flows: /thinkos-morning, /thinkos-plate, /thinkos-decide, /thinkos-who, /thinkos-vault, /thinkos-update. Each is a markdown playbook the agent reads; you can audit or edit any of them. Full list in § VI.',
  },
  {
    n: '03',
    title: 'Role-based bundles',
    body: 'Pick one preset and the right MCPs install for you: PM (Slack + Gmail + Notion + Linear + Granola + Figma), Engineering (Slack + Gmail + Atlassian + Linear), Design (Slack + Gmail + Notion + Figma + Granola), Operations (Slack + Gmail + Microsoft 365 + Notion + QuickBooks). Each pulls the matching Anthropic skill packs too.',
  },
  {
    n: '04',
    title: 'Skill routing baked in',
    body: 'The instructions teach the agent which Anthropic skill to invoke for which task. UI work routes to frontend-design. PR review to review. Security audits to security-review. SDK code to claude-api. You ask in plain English; the agent picks the right tool.',
  },
  {
    n: '05',
    title: 'Three-vault privacy model',
    body: 'Personal hub (local-only, never shared). Project vaults (shared via git, schema-enforced). Reference vaults (read-only imports). Your work log structurally cannot end up in a team repo — the team schema has no slot for it. Privacy as architecture, not policy.',
  },
  {
    n: '06',
    title: 'Self-healing onboarding',
    body: 'If anything in setup feels off — wrong command, missing step, confusing prompt — tell the agent. It opens a PR upstream so the next person doesn\'t hit it. The install gets better every time someone runs it. (Gated on gh CLI being authenticated.)',
  },
];

const rules = [
  {
    n: 'I',
    title: 'Files are the source of truth.',
    body: 'Tool memory, the Basic Memory index, and any tool-specific cache are derivatives. The markdown on disk is canonical.',
  },
  {
    n: 'II',
    title: 'Always-loaded context stays small.',
    body: 'About 280 lines load into every session — identity, current focus, project index. Anything bigger loads only when the question needs it.',
  },
  {
    n: 'III',
    title: 'Personal stays personal. Team stays team.',
    body: 'Your work log and private notes live in a vault only you can see. Project work lives in a separate vault shared with your team. The structure makes accidental crossover impossible.',
  },
];

const vaultTypes = [
  {
    name: 'Personal hub',
    kicker: 'Always local',
    body: 'Identity, current focus, work log, people notes, decisions, learnings. Lives on your disk, never shared.',
  },
  {
    name: 'Project vault',
    kicker: 'Shared via git',
    body: 'Team activity, project decisions, specs. Privacy enforced structurally — the schema has no slot for personal content, so it can\'t leak.',
  },
  {
    name: 'Reference vault',
    kicker: 'Read-only import',
    body: 'A folder of someone else\'s markdown you want indexed for search. Marked [reference] in agent output. Never written to.',
  },
];

const commands = [
  ['/thinkos-whoami',         'Quick identity + role + current focus'],
  ['/thinkos-morning',        'Daily brief — focus, plate, recent log'],
  ['/thinkos-plate',          'What\'s on your plate today'],
  ['/thinkos-log',            'Capture a timestamped note to your work log'],
  ['/thinkos-who',            'What you know about a specific person'],
  ['/thinkos-project',        'Load deep context for a project'],
  ['/thinkos-decisions',      'Search your standing decisions'],
  ['/thinkos-learnings',      'Search reusable learnings by topic'],
  ['/thinkos-decide',         'Record a standing decision'],
  ['/thinkos-capture',        'Capture a cross-project learning'],
  ['/thinkos-recent',         'Show recent captures by source — what landed and where'],
  ['/thinkos-undo-capture',   'Remove a capture from the vault and ledger'],
  ['/thinkos-autosave',       'Toggle periodic background session capture on/off'],
  ['/thinkos-capture-setup',  'Enable continuous-capture sources one at a time'],
  ['/thinkos-vault',          'Manage vaults — switch, create, clone'],
  ['/thinkos-continue',       'Resume Phase 2 context seeding'],
  ['/thinkos-automate',       'Set up scheduled triggers'],
  ['/thinkos-update',         'Pull latest instructions and commands, with drift detection'],
  ['/thinkos-help',           'Show every Think OS command'],
  ['/thinkos-mcp-help',       'How to query your context MCP'],
];

const faqs = [
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory itself is free and runs locally — no cloud mode, no recurring infrastructure cost. Phase 3 maintenance jobs run as local launchd jobs. The daily reindex uses no API tokens. The weekly review, quarterly archive, and morning brief each spawn a local claude session when they fire — those consume Anthropic API tokens; whether that\'s included in your Claude subscription or charged as pay-as-you-go depends on your account.',
  },
  {
    q: 'Which agent surfaces does Think OS support?',
    a: 'Claude Code is the primary target — full feature set: slash commands, autonomous launchd capture, drift-aware updates. Claude Cowork (the agentic tab in Claude Desktop) is also supported as of v0.4 with a thinner integration — same vault, same MCP, native onboarding chips, but no slash commands (Cowork uses a different plugin format) and one manual paste step for the curated instructions. Cowork can drive its own /schedule-based autonomous capture; Claude Code\'s launchd is more reliable since it doesn\'t require the app to stay open. Codex adapter is scaffolding only — install not yet wired.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- HERO -->
  <section class="mx-auto max-w-[1200px] px-6 md:px-10 pt-20 md:pt-28 pb-24 md:pb-36">
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 md:col-span-9 md:col-start-2">
        <div class="lift lift-1">
          <a
            href="https://thinkcompany.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[10px] tracking-[0.18em] uppercase text-muted hover:text-accent transition-colors"
          >
            A project from Think Company
          </a>
        </div>

        <h1 class="display lift lift-2 mt-8 text-[44px] md:text-[88px] lg:text-[104px] tracking-tightest">
          Personal context<br />
          that follows you<br />
          into <em>every agent session.</em>
        </h1>

        <p class="lift lift-3 mt-10 md:mt-12 max-w-[58ch] text-[17px] md:text-[19px] leading-relaxed text-muted">
          Think OS is a markdown vault and a context MCP server. It gives Claude Code and Claude Cowork
          durable memory of who you are, what you're working on, and how you like to
          work — across projects, sessions, and time.
        </p>

        <div class="lift lift-4 mt-12 max-w-[820px]">
          <InstallPrompt />
        </div>

        <p class="lift lift-5 mt-6 font-mono text-[11px] tracking-[0.18em] uppercase text-muted">
          Works in Claude Code &amp; Claude Cowork · Codex coming
        </p>
      </div>
    </div>
  </section>

  <!-- BENEFITS / WHAT YOU GET -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ I</p>
          <h2 class="display text-3xl md:text-4xl mt-4">What you get</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Not another note-taking app. Four concrete behaviors that change how
            you work with an agent.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-14">
        {benefits.map((b) => (
          <div class="col-span-12 md:col-span-6 grid grid-cols-12 gap-4 md:gap-6">
            <div class="col-span-3 md:col-span-2">
              <p class="numeral text-3xl md:text-4xl leading-none">{b.n}</p>
            </div>
            <div class="col-span-9 md:col-span-10">
              <h3 class="font-display text-xl md:text-2xl tracking-tight">{b.title}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted max-w-[42ch]">
                {b.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT IN — what actually installs -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ II</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Built in</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Think OS isn't just a folder of markdown. Installing it drops a curated
            agent instruction stack, twenty pre-built playbooks, a role-based MCP
            bundle, and skill routing into your environment. Every agent that touches
            the vault knows what to do without you teaching it.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-14">
        {installed.map((b) => (
          <div class="col-span-12 md:col-span-6 grid grid-cols-12 gap-4 md:gap-6">
            <div class="col-span-3 md:col-span-2">
              <p class="numeral text-3xl md:text-4xl leading-none">{b.n}</p>
            </div>
            <div class="col-span-9 md:col-span-10">
              <h3 class="font-display text-xl md:text-2xl tracking-tight">{b.title}</h3>
              <p class="mt-3 text-[16px] leading-relaxed text-muted max-w-[42ch]">
                {b.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SETUP IS THREE STEPS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ III</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Setup</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Three steps. About twenty-five minutes total. Most of it is the agent
            asking you four short questions, then drafting your context files
            from the tools you already use.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-x-6 gap-y-12">
        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:pr-8">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 1</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~5 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Install</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Paste the install prompt into a fresh Claude Code session. The agent
            clones the repo, asks four questions (vault location, Basic Memory,
            plugin bundle, vault name), optionally offers capability add-ons
            (Playwright browser capture, GitHub CLI auth), and runs the install.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:border-r md:border-rule md:px-8">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 2</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~2 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Restart + authenticate</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Quit Claude Code and reopen it. MCPs and new slash commands only
            load on startup.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            If you installed a plugin bundle, type
            <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/mcp</code> and
            authorize each connector listed.
          </p>
        </article>

        <article class="col-span-12 md:col-span-4 md:pl-8">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <p class="kicker">Step 3</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">~15–30 min</p>
          </div>
          <h3 class="font-display text-2xl md:text-3xl tracking-tight mt-5">Continue setup</h3>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            Type <code class="font-mono text-[14px] bg-soft px-1.5 py-0.5 rounded">/thinkos-continue</code>.
            The agent offers to import an existing markdown vault, pulls from your
            tools (Granola, Calendar, Slack, Gmail, Linear), and drafts your
            Identity, Project Index, Current Focus, and People files.
          </p>
          <p class="mt-4 text-[16px] leading-relaxed text-muted max-w-[42ch]">
            At the end, three grouped questions wire up all three capture layers: session capture (local, no API cost), vault maintenance triggers (daily reindex, weekly review, quarterly archive), and continuous capture sources (Calendar by default; Granola, Slack, Gmail, Linear, ClickUp opt-in).
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- THREE RULES -->
  <section class="border-t border-rule bg-soft/40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ IV</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Three rules</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            The architecture in one screen. If anything goes wrong, it'll be because
            one of these got violated.
          </p>
        </div>
      </header>

      <div class="space-y-10">
        {rules.map((r) => (
          <div class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8">
            <div class="col-span-2 md:col-span-1">
              <span class="numeral text-2xl md:text-3xl">{r.n}</span>
            </div>
            <div class="col-span-10 md:col-span-6">
              <p class="font-display text-2xl md:text-3xl tracking-tight">{r.title}</p>
            </div>
            <div class="col-span-12 md:col-span-5">
              <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">{r.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VAULT TYPES -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ V</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Vaults</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Three types, each with its own privacy model. Personal stays personal
            by construction — there's nowhere for it to leak into a shared repo.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule">
        {vaultTypes.map((v) => (
          <article class="bg-paper p-7 md:p-9">
            <p class="kicker">{v.kicker}</p>
            <h3 class="font-display text-2xl md:text-[28px] mt-5 tracking-tight">{v.name}</h3>
            <p class="mt-5 text-[15px] leading-relaxed text-muted">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMMANDS -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-12">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ VI</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Commands</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Every Think OS slash command, prefixed so they autocomplete as a group.
            Type <code class="font-mono bg-soft px-1.5 py-0.5 rounded text-[13px]">/thinkos</code> in
            Claude Code and tab through the list.
          </p>
        </div>
      </header>

      <div class="border-t border-rule">
        {commands.map(([cmd, desc]) => (
          <div class="grid grid-cols-12 gap-6 items-baseline border-b border-rule py-3.5 hover:bg-soft/50 transition-colors">
            <div class="col-span-12 md:col-span-4">
              <code class="font-mono text-[14px] md:text-[15px] text-ink">{cmd}</code>
            </div>
            <div class="col-span-12 md:col-span-8">
              <p class="text-[15px] text-muted">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTINUOUS CAPTURE -->
  <section class="border-t border-rule bg-soft/40">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-16">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ VII</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Continuous capture</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Three layers. Each is independent and opt-in beyond Layer A.
          </p>
        </div>
      </header>

      <div class="space-y-10">
        <div class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8">
          <div class="col-span-2 md:col-span-1">
            <span class="numeral text-2xl md:text-3xl">A</span>
          </div>
          <div class="col-span-10 md:col-span-6">
            <p class="font-display text-2xl md:text-3xl tracking-tight">Session capture.</p>
          </div>
          <div class="col-span-12 md:col-span-5">
            <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">
              A launchd job runs every 2 hours and appends a one-line stub to your
              Work Log (cwd, file count, last commit). No LLM call. No file contents
              leave your machine. Toggle with
              <code class="font-mono text-[13px] bg-paper px-1.5 py-0.5 rounded">/thinkos-autosave</code>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8">
          <div class="col-span-2 md:col-span-1">
            <span class="numeral text-2xl md:text-3xl">B</span>
          </div>
          <div class="col-span-10 md:col-span-6">
            <p class="font-display text-2xl md:text-3xl tracking-tight">External ingestion.</p>
          </div>
          <div class="col-span-12 md:col-span-5">
            <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">
              Opt-in per source. Hourly Granola, daily Calendar/Linear/ClickUp/Gmail,
              hourly Slack. Privacy-routing by keyword (comp, salary, HR, health,
              family) — those always land in your personal hub only. Configure with
              <code class="font-mono text-[13px] bg-paper px-1.5 py-0.5 rounded">/thinkos-capture-setup</code>.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-12 gap-4 md:gap-6 items-baseline border-t border-rule pt-8">
          <div class="col-span-2 md:col-span-1">
            <span class="numeral text-2xl md:text-3xl">C</span>
          </div>
          <div class="col-span-10 md:col-span-6">
            <p class="font-display text-2xl md:text-3xl tracking-tight">Audit and undo.</p>
          </div>
          <div class="col-span-12 md:col-span-5">
            <p class="text-[16px] leading-relaxed text-muted max-w-[50ch]">
              Every capture writes one line to
              <code class="font-mono text-[13px] bg-paper px-1.5 py-0.5 rounded">90 System/Capture Log.md</code> in the vault.
              <code class="font-mono text-[13px] bg-paper px-1.5 py-0.5 rounded">/thinkos-recent</code> shows
              what landed and from which source.
              <code class="font-mono text-[13px] bg-paper px-1.5 py-0.5 rounded">/thinkos-undo-capture</code> removes
              any entry from both the vault and the ledger. Full design:
              <a href="/docs/continuous-capture" class="underline underline-offset-2">docs/continuous-capture</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STAYING CURRENT -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-12">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ VIII</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Staying current</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            Think OS ships updates to its curated instructions and slash commands.
            Your vault is never touched by an update.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-4">
          <p class="text-[16px] leading-relaxed text-muted">
            From any Claude Code session, run:
          </p>
          <pre class="mt-4 bg-soft border border-rule rounded px-5 py-4 font-mono text-[14px] overflow-x-auto">/thinkos-update</pre>
          <p class="mt-6 text-[16px] leading-relaxed text-muted max-w-[66ch]">
            The agent fetches the latest commits, summarizes what changed, checks
            for drift on any managed file you edited locally (sha256 comparison),
            asks before overwriting, and atomically re-applies. See
            <a href="/docs/update-protocol" class="underline underline-offset-2">docs/update-protocol</a>
            for the full flow, file categories, and backup behavior.
          </p>
          <p class="mt-6 text-[16px] leading-relaxed text-muted max-w-[66ch]">
            For a non-interactive terminal refresh:
          </p>
          <pre class="mt-4 bg-soft border border-rule rounded px-5 py-4 font-mono text-[14px] overflow-x-auto">cd ~/code/think-os
bash scripts/thinkos-update.sh --pull</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28">
      <header class="grid grid-cols-12 gap-6 mb-12">
        <div class="col-span-12 md:col-span-3">
          <p class="kicker">§ IX</p>
          <h2 class="display text-3xl md:text-4xl mt-4">Questions</h2>
        </div>
        <div class="col-span-12 md:col-span-8 md:col-start-5">
          <p class="text-[17px] md:text-[18px] leading-relaxed text-muted max-w-[60ch]">
            What testers usually ask first.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-9 md:col-start-4">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="faq-body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING ORNAMENT -->
  <div class="ornament py-16">❦ &nbsp; · &nbsp; ❦ &nbsp; · &nbsp; ❦</div>

</BaseLayout>
