---
// Homepage v4. Two registers alternate down the page:
//   A · EDITORIAL (light) — dense, oversized display type, layered overlapping
//       cards with soft shadows, mono micro-annotations (.annot with a tick),
//       occasional rotated cards, soft blue washes. White space is earned.
//   B · THEATER (dark takeover) — full-bleed #06101B with a radial Think-blue
//       glow, generous padding, light ink, panes lit with an outer blue glow.
//       Entering a theater feels like the lights going down.
//
// S2 (read-trace) and S4 (day chapters) render their COMPLETE final state
// server-side, visible by default. When motion is permitted (reveal-ready)
// and the scene enters, a per-section IntersectionObserver clears and REPLAYS
// the sequence using the cancellable-typing pattern (the same approach
// TryTerminal uses). The resident step engine is no longer used here — it
// hides [data-step] content until played, which is the opposite of the
// static-final-complete invariant below.
//
// Invariants preserved: reduced-motion collapses to static-final-complete;
// no-JS server-renders all content visible; reveal CSS gated on
// .reveal-ready; brand tokens unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import WorksWith from '../components/WorksWith.astro';
import ChangelogPreview from '../components/ChangelogPreview.astro';
import TryTerminal from '../components/TryTerminal.astro';
import TerminalPane from '../components/panes/TerminalPane.astro';

// S3 — the eight files of the folder anatomy.
const anatomy = [
  { name: 'Identity.md',      excerpt: 'Design lead. Plans first, plain language.', tier: 'HOT' },
  { name: 'Current Focus.md', excerpt: "This week's top 3, refreshed Sundays.",     tier: 'HOT' },
  { name: 'Tasks.md',         excerpt: "Today's plate, synced from your tools.",     tier: '' },
  { name: 'Work Log.md',      excerpt: 'Appends itself while you work.',             tier: '' },
  { name: 'People.md',        excerpt: 'Priya — eng lead, prefers async.',           tier: '' },
  { name: 'Decisions.md',     excerpt: 'API versioned from day one — and why.',      tier: '' },
  { name: 'Learnings.md',     excerpt: 'Demos beat decks.',                          tier: '' },
  { name: 'Projects/',        excerpt: 'One folder per active project.',             tier: '' },
];

// S5 — what it won't do.
const honest = [
  {
    title: '> stays local',
    body: 'Files on your disk, indexed locally — they leave only if you sync them.',
    rot: '-0.6deg',
  },
  {
    title: '> captures metadata, not content',
    body: 'The background log records folders, counts, a commit hash. Never what you typed.',
    rot: '0.6deg',
  },
  {
    title: '> asks before it writes',
    body: 'Decisions get logged when you say yes, not silently.',
    rot: '-0.6deg',
  },
];

// S7 — fifteen minutes, once.
const steps = [
  {
    n: '01',
    title: 'Install',
    body: 'Paste the prompt into Claude Code; it clones, asks five questions, runs setup.',
  },
  {
    n: '02',
    title: 'Restart',
    body: 'Commands and MCPs load on startup; authorize connectors if you added a bundle.',
  },
  {
    n: '03',
    title: 'Let it fill in',
    body: 'The vault seeds itself from real conversations, or run /thinkos-continue to bulk-import.',
  },
];

// S8 — FAQ. Same six as before, minus the retired "Which agent surfaces" entry.
const faqs = [
  {
    q: 'What do I actually do day to day?',
    a: 'One command in the morning (/thinkos-morning), a one-line capture when you make a decision worth keeping, and a twenty-minute /weekly-review on Sunday — the rest happens on its own. The full rhythm, dos and don\'ts included, is in',
    link: { href: '/guide', label: 'How to use it' },
  },
  {
    q: 'Does my vault data leave my machine?',
    a: 'No. Think OS is local-first. Basic Memory runs as a stdio MCP server — your markdown files stay on disk, indexed by SQLite on your machine. They only leave if you explicitly choose to sync (git, iCloud, Syncthing).',
  },
  {
    q: 'Why markdown files instead of a vector or graph database?',
    a: 'You don\'t have to choose — Basic Memory derives full-text search, local embeddings, and a knowledge graph FROM your files, so retrieval is database-grade and the files stay auditable and editable anywhere. The long version is in docs/why-files-not-a-database.md on GitHub.',
  },
  {
    q: 'Can I use my existing Obsidian vault?',
    a: 'Yes. Phase 2 has an import step — point it at your existing markdown folder, it maps your filenames to Think OS slots (identity.md → 05 Profile/Identity.md, etc.), copies the content, and skips auto-population for the slots you already filled.',
  },
  {
    q: 'What about cost?',
    a: 'Basic Memory is free and local. The scheduled jobs run on your machine; only the weekly review, quarterly archive, and morning brief spawn a Claude session, which uses your existing Claude plan or API billing.',
  },
  {
    q: 'How do I uninstall?',
    a: 'bash scripts/thinkos-uninstall.sh --dry-run shows you the plan; run it without --dry-run to apply. By default your vault folder is preserved — pass --remove-vault to delete it too. Backups of any modified global files (~/.claude/CLAUDE.md, ~/.claude/commands/) are left in place with a .pre-thinkos-backup-<date> suffix.',
  },
];
---
<BaseLayout>

  <!-- ============================================================
       S1 · HERO — EDITORIAL. Dense two-column. Left: copy.
       Right: a layered collage (terminal over vault card, two
       file cards fanned behind, mono annotations with ticks).
       Parallax via JS (transform only, reduced-motion disabled).
       ============================================================ -->
  <section class="play-on-load editorial border-b border-rule">
    <div class="wash-blue" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 pt-16 md:pt-24 pb-20 md:pb-28">
      <div class="hero-grid">
        <!-- LEFT — copy -->
        <div class="hero-copy">
          <p class="annot po-1">A personal context OS for Claude</p>
          <h1 class="display po-2 mt-5 text-[clamp(40px,8.4vw,120px)] max-w-[16ch]">
            Every new chat, Claude meets you for the first time.
          </h1>
          <p class="po-3 mt-7 max-w-[52ch] text-[18px] leading-relaxed text-muted" style="font-variation-settings:'opsz' 16">
            Think OS fixes that with a folder of markdown files Claude reads
            before it answers — your work, your people, your decisions. Set it
            up once; it keeps itself current.
          </p>
          <div class="po-4 mt-10 max-w-[640px] hero-install">
            <InstallPrompt />
          </div>
          <p class="po-4 mt-6 font-mono text-[12px] tracking-[0.06em]">
            <a href="#theater-read" class="link-anim text-accent">↓ watch it use what it knows</a>
          </p>
        </div>

        <!-- RIGHT — the collage (density). -->
        <div class="hero-collage po-3" aria-hidden="false">
          <!-- fanned file cards behind -->
          <div class="collage-file file-a" data-parallax="0.04">
            <p class="cf-name">Identity.md</p>
            <p class="cf-line">Design lead. Plans first,</p>
            <p class="cf-line">plain language, no fluff.</p>
          </div>
          <div class="collage-file file-b" data-parallax="0.07">
            <p class="cf-name">Decisions.md</p>
            <p class="cf-line">2026-06-11 — API versioning.</p>
            <p class="cf-line">Versioned from day one.</p>
          </div>

          <!-- the vault card (light) -->
          <div class="collage-vault" data-parallax="0.12">
            <p class="cv-title">~/ThinkOS/vault</p>
            <ul class="cv-rows">
              <li><span class="cv-i">05</span> Identity.md</li>
              <li><span class="cv-i">01</span> Current Focus.md</li>
              <li><span class="cv-i">01</span> Tasks.md</li>
              <li><span class="cv-i">03</span> People.md</li>
              <li><span class="cv-i">04</span> Decisions.md</li>
              <li><span class="cv-i">04</span> Learnings.md</li>
            </ul>
            <span class="annot annot-vault">plain markdown — yours</span>
          </div>

          <!-- the terminal pane (dark), overlapping the vault -->
          <div class="collage-term" data-parallax="0.18">
            <TerminalPane label="claude code" tag="reads first"><span class="prompt">&gt;</span> <span class="cmd">good morning</span>
<span class="dim">This week (top 3): v2 release…</span>
<span class="dim">On your plate: 1:1 with Priya, 2pm</span></TerminalPane>
            <span class="annot annot-term">reads before it answers</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S2 · THEATER 1 — THE PRODUCT ARGUMENT, interactive.
       Lights go down. Terminal on the left, a vault rail on the
       right. Each printed response line traces to a file.
       ============================================================ -->
  <section id="theater-read" class="theater" data-read-root>
    <div class="theater-glow" style="--gx:22%; --gy:38%" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-28 md:py-32 relative">
      <header class="mb-12">
        <p class="t-kicker">Watch</p>
        <h2 class="t-heading mt-3">It answers from your files.</h2>
      </header>

      <div class="stage-read" data-trace-root>
        <!-- LEFT — terminal. Full conversation server-rendered + visible by
             default. With motion, JS clears + replays (type prompt, then
             glow-source-chip → print each line). -->
        <div class="stage-term">
          <div class="pane pane-lit">
            <div class="pane-bar">
              <span class="pane-path">claude code</span>
              <span class="pane-tag" data-kind="read">live</span>
            </div>
            <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt">&gt;</span> <span class="cmd" data-read-cmd>draft a standup for the v2 project</span><span class="trace-out"><button type="button" class="trace-line" data-source="focus"><span class="line-stagger ls-gap">v2 ingestion — release cut today</span></button><button type="button" class="trace-line" data-source="people"><span class="line-stagger">pairing with Priya on rollout notes</span></button><button type="button" class="trace-line" data-source="decisions"><span class="line-stagger">holding the /v1 prefix per the API decision</span></button></span></pre>
          </div>
        </div>

        <!-- RIGHT — vault rail. All five chips render statically; only the
             glow class + connector lines are choreography. -->
        <div class="stage-rail">
          <span class="rail-chip" data-chip="identity">Identity.md</span>
          <span class="rail-chip" data-chip="focus">Current Focus.md</span>
          <span class="rail-chip" data-chip="people">People.md</span>
          <span class="rail-chip" data-chip="decisions">Decisions.md</span>
          <span class="rail-chip" data-chip="worklog">Work Log.md</span>
        </div>

        <!-- connector overlay (desktop) — JS draws lines chip→line -->
        <svg class="trace-svg" data-trace-svg aria-hidden="true" preserveAspectRatio="none"></svg>
      </div>

      <p class="t-caption mt-10" data-read-caption>
        Each line traces to a file. That's the whole product.
      </p>
      <p class="mt-4 font-mono text-[10px] tracking-[0.16em] uppercase t-fine">
        Sample vault content — your real vault has your real notes.
      </p>
    </div>
  </section>

  <!-- ============================================================
       S3 · EDITORIAL — THE MEMORY IS A FOLDER. Oversized folder
       anatomy: a big light card holding eight file cards, ringed
       by mono annotations with ticks.
       ============================================================ -->
  <section class="editorial border-t border-rule">
    <div class="wash-blue wash-soft" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-24 md:py-32">
      <header class="mb-12 max-w-[42ch]">
        <p class="annot">No database to babysit</p>
        <h2 class="display mt-5 text-[clamp(36px,6vw,84px)] max-w-[14ch]">The memory is a folder.</h2>
      </header>

      <div class="anatomy-wrap">
        <span class="annot annot-float af-1">Open in Obsidian, VS Code, anything</span>
        <span class="annot annot-float af-2">Git-syncable</span>
        <span class="annot annot-float af-3">Search + links derived from the files</span>

        <div class="folder-card">
          <p class="fc-title font-mono">~/ThinkOS/vault</p>
          <div class="anatomy-grid">
            {anatomy.map((f) => (
              <article class="afile">
                <div class="afile-head">
                  <span class="afile-name font-mono">{f.name}</span>
                  {f.tier && <span class="afile-tier font-mono">{f.tier}</span>}
                </div>
                <p class="afile-excerpt">{f.excerpt}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <p class="mt-12 text-[16px] leading-relaxed text-muted max-w-[60ch]" style="font-variation-settings:'opsz' 16">
        Claude doesn't browse this folder — a local index (full-text, embeddings,
        links) makes it queryable, and the files stay the source of truth. Plain
        markdown you can read, edit, and version like anything else you own.
      </p>
    </div>
  </section>

  <!-- ============================================================
       S4 · THEATER 2 — A DAY WRITES ITSELF. Chaptered interactive:
       four ARIA tabs, each replays a terminal + effect-pane scene.
       Chapter 1 auto-plays on enter via the step engine.
       ============================================================ -->
  <section class="theater" data-day-root>
    <div class="theater-glow" style="--gx:78%; --gy:30%" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-28 md:py-32 relative">
      <header class="mb-10">
        <p class="t-kicker">While you work</p>
        <h2 class="t-heading mt-3">A day writes itself.</h2>
      </header>

      <div class="day-tabs" role="tablist" aria-label="A day with Think OS">
        <button type="button" role="tab" class="day-tab" id="day-tab-0" aria-controls="day-panel-0" aria-selected="true" data-chapter="0">08:40 morning</button>
        <button type="button" role="tab" class="day-tab" id="day-tab-1" aria-controls="day-panel-1" aria-selected="false" tabindex="-1" data-chapter="1">11:00 working</button>
        <button type="button" role="tab" class="day-tab" id="day-tab-2" aria-controls="day-panel-2" aria-selected="false" tabindex="-1" data-chapter="2">14:12 a decision</button>
        <button type="button" role="tab" class="day-tab" id="day-tab-3" aria-controls="day-panel-3" aria-selected="false" tabindex="-1" data-chapter="3">sun 20:00 review</button>
      </div>

      <!-- Four chapter panels, all server-rendered. No-JS tab pattern:
           [hidden] on every panel except the active one; chapter 1 visible.
           JS replay reads text from these panels (no innerHTML injection). -->
      <div class="day-panels">
        <!-- CH 0 — morning -->
        <div class="day-stage" id="day-panel-0" role="tabpanel" aria-labelledby="day-tab-0" data-chapter-panel="0">
          <div class="day-term">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path">claude code</span>
                <span class="pane-tag" data-kind="read" data-day-tag>morning</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt" data-day-prompt>&gt;</span> <span class="cmd" data-day-cmd>good morning</span>
<span class="dim" data-day-out>This week (top 3)… Calendar: 2 meetings.</span></pre>
            </div>
          </div>
          <div class="day-effect">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path" data-day-fx-path>01 Now/Current Focus.md</span>
                <span class="pane-tag" data-kind="read" data-day-fx-tag>read</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words" data-day-fx-body><span class="read-row">Current Focus.md — read</span></pre>
              <p class="day-fx-note font-mono" data-day-fx-note hidden></p>
            </div>
          </div>
        </div>

        <!-- CH 1 — working -->
        <div class="day-stage" id="day-panel-1" role="tabpanel" aria-labelledby="day-tab-1" data-chapter-panel="1" hidden>
          <div class="day-term">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path">claude code</span>
                <span class="pane-tag" data-kind="read" data-day-tag>working</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt" data-day-prompt></span><span class="cmd" data-day-cmd>— you’re in your editor, not here —</span>
<span class="dim" data-day-out></span></pre>
            </div>
          </div>
          <div class="day-effect">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path" data-day-fx-path>01 Now/Work Log.md</span>
                <span class="pane-tag" data-kind="add" data-day-fx-tag>+2 lines</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words" data-day-fx-body><span class="diff-add">+ ### 11:00 — acme-redesign</span>
<span class="diff-add">+ 12 files · HEAD a1b2c3d</span></pre>
              <p class="day-fx-note font-mono" data-day-fx-note>metadata only — never content</p>
            </div>
          </div>
        </div>

        <!-- CH 2 — a decision -->
        <div class="day-stage" id="day-panel-2" role="tabpanel" aria-labelledby="day-tab-2" data-chapter-panel="2" hidden>
          <div class="day-term">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path">claude code</span>
                <span class="pane-tag" data-kind="read" data-day-tag>a decision</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt" data-day-prompt>&gt;</span> <span class="cmd" data-day-cmd>log it: we’re versioning the API from day one</span>
<span class="dim" data-day-out>Noted. Want it in Decisions? (y/n) > y</span></pre>
            </div>
          </div>
          <div class="day-effect">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path" data-day-fx-path>04 Knowledge/Decisions.md</span>
                <span class="pane-tag" data-kind="add" data-day-fx-tag>+1 entry</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words" data-day-fx-body><span class="diff-add">+ ## 2026-06-12 — API versioning…</span></pre>
              <p class="day-fx-note font-mono" data-day-fx-note hidden></p>
            </div>
          </div>
        </div>

        <!-- CH 3 — review -->
        <div class="day-stage" id="day-panel-3" role="tabpanel" aria-labelledby="day-tab-3" data-chapter-panel="3" hidden>
          <div class="day-term">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path">claude code</span>
                <span class="pane-tag" data-kind="read" data-day-tag>review</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words"><span class="prompt" data-day-prompt>&gt;</span> <span class="cmd" data-day-cmd>/weekly-review</span>
<span class="dim" data-day-out>Archiving this week… drafting next.</span></pre>
            </div>
          </div>
          <div class="day-effect">
            <div class="pane pane-lit">
              <div class="pane-bar">
                <span class="pane-path" data-day-fx-path>01 Now/Current Focus.md</span>
                <span class="pane-tag" data-kind="add" data-day-fx-tag>replaced</span>
              </div>
              <pre class="pane-body whitespace-pre-wrap break-words" data-day-fx-body><span class="diff-del">- week of Jun 5 — v2 cut, hiring draft</span>
<span class="diff-add">+ week of Jun 12 — rollout, Q3 plan</span></pre>
              <p class="day-fx-note font-mono" data-day-fx-note hidden></p>
            </div>
          </div>
        </div>
      </div>

      <p class="t-caption mt-10">
        One command in the morning. One on Sunday. The rest writes itself.
      </p>
    </div>
  </section>

  <!-- ============================================================
       S5 · EDITORIAL — WHAT IT WON'T DO. Three compact rule-border
       cards in a row, slight alternating rotation.
       ============================================================ -->
  <section class="editorial border-t border-rule">
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-24 md:py-32">
      <header class="mb-14 max-w-[40ch]">
        <p class="annot">Built honest</p>
        <h2 class="display mt-5 text-[clamp(36px,6vw,84px)] max-w-[12ch]">What it won't do.</h2>
      </header>

      <div class="honest-row">
        {honest.map((h) => (
          <article class="honest-card" style={`--rot:${h.rot}`}>
            <p class="honest-title font-mono">{h.title}</p>
            <p class="honest-body">{h.body}</p>
          </article>
        ))}
      </div>
      <p class="annot mt-10">The long answers live in the FAQ ↓</p>
    </div>
  </section>

  <!-- ============================================================
       S6 · THEATER 3 — YOUR TURN. The existing TryTerminal,
       centered, on the dark stage it was built for.
       ============================================================ -->
  <section class="theater">
    <div class="theater-glow" style="--gx:50%; --gy:34%" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-28 md:py-32 relative">
      <header class="mb-12 text-center">
        <p class="t-kicker">Your turn</p>
        <h2 class="t-heading mt-3">Type something.</h2>
      </header>
      <div class="mx-auto max-w-[860px]">
        <TryTerminal />
      </div>
    </div>
  </section>

  <!-- WORKS WITH — kept, between S6 and S7. -->
  <WorksWith />

  <!-- ============================================================
       S7 · EDITORIAL — FIFTEEN MINUTES, ONCE. Three numbered step
       cards, then InstallPrompt + ChangelogPreview side by side.
       ============================================================ -->
  <section class="editorial border-t border-rule">
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 py-24 md:py-32">
      <header class="mb-14 max-w-[40ch]">
        <h2 class="display text-[clamp(36px,6vw,84px)] max-w-[16ch]">Fifteen minutes, once.</h2>
      </header>

      <div class="steps-row">
        {steps.map((s) => (
          <article class="step-card">
            <span class="step-n font-mono">{s.n}</span>
            <p class="step-title font-mono">{s.title}</p>
            <p class="step-body">{s.body}</p>
          </article>
        ))}
      </div>

      <div class="start-grid mt-14">
        <div class="min-w-0"><InstallPrompt /></div>
        <div class="min-w-0"><ChangelogPreview /></div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S8 · EDITORIAL — QUESTIONS + CLOSE.
       ============================================================ -->
  <section class="editorial border-t border-rule">
    <div class="mx-auto max-w-[1240px] px-6 md:px-10 pt-24 md:pt-32 pb-16">
      <header class="mb-12">
        <h2 class="md-heading">Questions</h2>
      </header>

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-10">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="faq-body">
                {f.a}
                {f.link && (
                  <>
                    {' '}
                    <a href={f.link.href} class="underline underline-offset-2 hover:text-accent">{f.link.label}</a>.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
        <!-- right gutter — single vertical annotation, desktop only. -->
        <div class="hidden md:flex md:col-span-2 faq-gutter" aria-hidden="true">
          <span class="faq-gutter-annot font-mono">THE FULL RHYTHM LIVES IN /guide</span>
        </div>
      </div>

      <div class="mt-24">
        <p class="display text-[clamp(40px,7vw,56px)] max-w-[20ch]">
          Stop being a stranger.
        </p>
        <p class="mt-8 font-mono text-[12px] tracking-[0.08em]">
          <a href="#main" class="link-anim text-muted">Install ↑</a>
          <span class="mx-3 text-muted opacity-50">·</span>
